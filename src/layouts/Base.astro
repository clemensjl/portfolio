---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
// Die zwei Schriften des ersten Viewports vorladen: der Name im Hero ist das LCP-Element.
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import textFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
}

const { lang, title, description, path, image = '/og-default.png', noindex = false } = Astro.props;
const site = (Astro.site?.href ?? '').replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && (
      <Fragment>
      <link rel="canonical" href={`${site}/${lang}${path}`} />
      <link rel="alternate" hreflang="de" href={`${site}/de${path}`} />
      <link rel="alternate" hreflang="en" href={`${site}/en${path}`} />
      <link rel="alternate" hreflang="x-default" href={`${site}/de${path}`} />
      </Fragment>
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/${lang}${path}`} />
    <meta property="og:image" content={`${site}${image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d0f12" />
    <slot name="head" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      document.documentElement.classList.add('js');
      // Ausfallsicherung: kommt das Modul-Skript nie an, blendet [data-reveal] sonst nichts mehr ein.
      addEventListener('load', function () {
        setTimeout(function () {
          if (window.__motion) return;
          document.documentElement.classList.remove('js');
        }, 1500);
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
