---
// Vorschau: KernClean 2.1.0 (Windows-Aufraeum-Tool, C#/.NET 8/WPF), Ansicht "Speicher".
// Farben, Labels und Meldungen stammen aus dem echten Repo (Themes/Dark.xaml, Views/StorageView.xaml,
// ViewModels/StorageViewModel.cs, ViewModels/StorageLogic.cs, Core/HtmlReportWriter.cs).
// Alle Zahlen sind ein Beispielzustand, keine Produktbehauptung.
//
// Schritt 0: Hauptfenster vor dem Scan, Laufwerk C: mit Belegungsanzeige und dem Knopf "Analysieren".
// Schritt 1: Der schnelle NTFS-Scan laeuft, der Dateizaehler rast hoch, darunter das USN-Inventar.
// Schritt 2: Die Treemap der Verzeichnisse baut sich gestaffelt auf, drei Duplikatgruppen sind amber markiert.
// Schritt 3: Die markierten Kopien werden per Hardlink zusammengelegt, die Flaechen schrumpfen, der freigegebene Platz erscheint.

interface Props { lang: 'de' | 'en' }
const { lang = 'de' } = Astro.props;

const T = {
  de: {
    aria:
      'Vorschau der Aufraeum-App KernClean: das Fenster zeigt die Speicheranalyse eines Laufwerks, ' +
      'den laufenden NTFS-Schnellscan, die Treemap der Verzeichnisse und das Zusammenlegen der Duplikate per Hardlink.',
  },
  en: {
    aria:
      'Preview of the Windows cleanup app KernClean: the window shows a drive storage analysis, ' +
      'the running NTFS fast scan, the directory treemap, and duplicates being merged into hard links.',
  },
}[lang];

// Navigation des echten Hauptfensters (MainWindowViewModel.Pages)
const nav = [
  { label: 'Übersicht', icon: 'grid' },
  { label: 'Aufräumen', icon: 'bin' },
  { label: 'Speicher', icon: 'disc', active: true },
  { label: 'Programme', icon: 'box' },
  { label: 'Autostart & Dienste', icon: 'power' },
  { label: 'Privatsphäre', icon: 'eye' },
  { label: 'Sicher löschen', icon: 'shield' },
  { label: 'System', icon: 'chip' },
];

// Treemap: Rechtecke in einem 100x100-Koordinatensystem, Flaeche proportional zur Groesse.
// Farben: Serien-Palette des HTML-Reports (HtmlReportWriter, dark).
const tiles = [
  { n: 'Windows',            s: '79,1 GB',  x: 0,  y: 0,  w: 38, h: 34, c: '#3987e5' },
  { n: 'Program Files',      s: '26,9 GB',  x: 0,  y: 34, w: 22, h: 20, c: '#199e70' },
  { n: 'Program Files (x86)', s: '19,6 GB', x: 22, y: 34, w: 16, h: 20, c: '#199e70' },
  { n: 'ProgramData',        s: '55,9 GB',  x: 0,  y: 54, w: 38, h: 24, c: '#9085e9' },
  { n: 'Temp',               s: '29,6 GB',  x: 0,  y: 78, w: 22, h: 22, c: '#898781' },
  { n: '$Recycle.Bin',       s: '21,6 GB',  x: 22, y: 78, w: 16, h: 22, c: '#898781' },
  { n: 'clemens',            s: '60,6 GB',  x: 38, y: 0,  w: 33, h: 30, c: '#c98500', ink: true },
  { n: 'Fotos',              s: '48,5 GB',  x: 38, y: 30, w: 33, h: 24, c: '#d55181', dup: true, shrink: 0.74 },
  { n: 'Backups',            s: '44,5 GB',  x: 38, y: 54, w: 33, h: 22, c: '#d95926', dup: true, shrink: 0.76 },
  { n: 'Downloads',          s: '27,9 GB',  x: 38, y: 76, w: 19, h: 24, c: '#e66767' },
  { n: 'Musik',              s: '20,6 GB',  x: 57, y: 76, w: 14, h: 24, c: '#e66767' },
  { n: 'Spiele',             s: '53,3 GB',  x: 71, y: 0,  w: 29, h: 30, c: '#008300' },
  { n: 'Videos',             s: '42,6 GB',  x: 71, y: 30, w: 29, h: 24, c: '#d55181', dup: true, shrink: 0.78 },
  { n: 'Dokumente',          s: '32,0 GB',  x: 71, y: 54, w: 29, h: 18, c: '#3987e5' },
  { n: 'node_modules',       s: '27,4 GB',  x: 71, y: 72, w: 16, h: 28, c: '#898781' },
  { n: '(Dateien)',          s: '22,3 GB',  x: 87, y: 72, w: 13, h: 28, c: '#898781' },
];

// Belegungsanzeige Laufwerk C: (Schritt 0), Segmente in denselben Serienfarben.
const drive = [
  { w: 21.4, c: '#3987e5' },
  { w: 15.0, c: '#9085e9' },
  { w: 13.0, c: '#c98500' },
  { w: 14.9, c: '#d55181' },
  { w: 12.5, c: '#008300' },
  { w: 12.6, c: '#898781' },
];

// Duplikatgruppen: Kopfzeile im Format der echten Anzeige ("{n} Kopien · {Groesse}", DupRow).
const dups = [
  { head: '4 Kopien · 15,7 GB', files: ['C:\\Users\\clemens\\Fotos\\Rohdaten\\IMG_4472.CR2', 'C:\\Users\\clemens\\Backups\\2024-11\\IMG_4472.CR2'] },
  { head: '3 Kopien · 9,4 GB', files: ['C:\\Users\\clemens\\Videos\\Schnitt\\takes_roh.mov', 'C:\\Users\\clemens\\Backups\\2024-11\\takes_roh.mov'] },
  { head: '6 Kopien · 7,2 GB', files: ['C:\\Users\\clemens\\Fotos\\Export\\panorama_final.tif', 'C:\\Users\\clemens\\Backups\\2024-08\\panorama_final.tif'] },
  { head: '2 Kopien · 5,9 GB', files: ['C:\\Users\\clemens\\Videos\\Rohmaterial\\clip_0148.mp4', 'C:\\Users\\clemens\\Backups\\2024-06\\clip_0148.mp4'] },
  { head: '3 Kopien · 4,3 GB', files: ['C:\\Users\\clemens\\Fotos\\2019\\hochzeit_scan.psd', 'C:\\Users\\clemens\\Backups\\2024-06\\hochzeit_scan.psd'] },
];

const icons: Record<string, string> = {
  grid: '<rect x="2.5" y="2.5" width="4.5" height="4.5" rx="1"/><rect x="9" y="2.5" width="4.5" height="4.5" rx="1"/><rect x="2.5" y="9" width="4.5" height="4.5" rx="1"/><rect x="9" y="9" width="4.5" height="4.5" rx="1"/>',
  bin: '<path d="M3.5 4.5h9M6.5 4.5V3h3v1.5M5 4.5l.6 9h4.8l.6-9"/>',
  disc: '<circle cx="8" cy="8" r="5.5"/><circle cx="8" cy="8" r="1.6"/>',
  box: '<path d="M2.5 5.2 8 2.6l5.5 2.6v5.6L8 13.4 2.5 10.8Z"/><path d="M2.5 5.2 8 7.8l5.5-2.6M8 7.8v5.6"/>',
  power: '<path d="M8 2.4v5.2"/><path d="M11.6 4.4a5 5 0 1 1-7.2 0"/>',
  eye: '<path d="M1.8 8S4.4 3.8 8 3.8 14.2 8 14.2 8 11.6 12.2 8 12.2 1.8 8 1.8 8Z"/><circle cx="8" cy="8" r="1.7"/>',
  shield: '<path d="M8 2.3 3.3 4.1v4.2c0 2.6 2 4.3 4.7 5.4 2.7-1.1 4.7-2.8 4.7-5.4V4.1Z"/>',
  chip: '<rect x="4.4" y="4.4" width="7.2" height="7.2" rx="1"/><path d="M6.6 2.4v2M9.4 2.4v2M6.6 11.6v2M9.4 11.6v2M2.4 6.6h2M2.4 9.4h2M11.6 6.6h2M11.6 9.4h2"/>',
};
---

<div class="pv pv-kern-clean" data-preview data-step="0" role="img" aria-label={T.aria}>
  <div class="kc-win">
    <!-- Titelleiste -->
    <div class="kc-title">
      <span class="kc-title-text">KernClean</span>
      <span class="kc-chrome"><i></i><i></i><i class="x"></i></span>
    </div>

    <div class="kc-body">
      <!-- Navigationsleiste -->
      <div class="kc-nav">
        <div class="kc-brand">
          <span class="kc-mark">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.6"/><circle cx="8" cy="8" r="1.7"/></svg>
          </span>
          <span class="kc-brand-name">KernClean</span>
        </div>
        <div class="kc-version">KernClean 2.1.0</div>
        <div class="kc-nav-list">
          {nav.map((item) => (
            <div class={`kc-nav-item${item.active ? ' is-active' : ''}`}>
              <span class="kc-nav-bar"></span>
              <span
                class="kc-nav-icon"
                set:html={`<svg viewBox="0 0 16 16" width="100%" height="100%" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">${icons[item.icon]}</svg>`}
              />
              <span class="kc-nav-label">{item.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Inhalt -->
      <div class="kc-main">
        <div class="kc-head">
          <span class="kc-h1">Speicher</span>
          <span class="kc-freed">58,3 GB freigegeben</span>
        </div>

        <div class="kc-pathbar">
          <span class="kc-input">C:\Users\clemens</span>
          <span class="kc-btn kc-btn-primary">Analysieren</span>
          <span class="kc-btn">Duplikate finden</span>
        </div>

        <div class="kc-options">
          <span class="kc-check"><span class="kc-box"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3.6 8.4 2.9 3 5.9-6.2"/></svg></span>Schneller NTFS-Scan (Admin)</span>
          <span class="kc-btn kc-btn-small">HTML-Report erstellen</span>
        </div>

        <div class="kc-cards">
          <!-- Linke Karte: Analyse / Treemap -->
          <div class="kc-card kc-card-map">
            <div class="kc-card-head">
              <span class="kc-stack kc-h2">
                <span data-s="0">Speicheranalyse</span>
                <span data-s="1">Speicheranalyse</span>
                <span data-s="2">Treemap der Verzeichnisse</span>
                <span data-s="3">Treemap der Verzeichnisse</span>
              </span>
              <span class="kc-stack kc-sum">
                <span data-s="0">Laufwerk C: · noch nicht analysiert</span>
                <span data-s="1">Schneller NTFS-Scan läuft</span>
                <span data-s="2">Gesamt: 612,4 GB · NTFS-Schnellscan</span>
                <span data-s="3">Gesamt: 554,1 GB · NTFS-Schnellscan</span>
              </span>
            </div>

            <div class="kc-stage">
              <!-- Schritt 0: Laufwerk mit Belegungsanzeige -->
              <div class="kc-drive">
                <div class="kc-drive-row">
                  <span class="kc-drive-name">Laufwerk C:</span>
                  <span class="kc-drive-val">612,4 GB von 930,9 GB belegt</span>
                </div>
                <div class="kc-drive-bar">
                  {drive.map((seg) => <span style={`width:${seg.w}%;background:${seg.c}`}></span>)}
                  <span class="kc-drive-free"></span>
                </div>
                <div class="kc-drive-legend">
                  <span><i style="background:#3987e5"></i>belegt nach Ordner</span>
                  <span><i class="free"></i>318,5 GB frei</span>
                </div>
                <div class="kc-drive-hint">
                  Fläche = Speicherplatz. Der Scan liest das NTFS-Inventar direkt und ist deutlich schneller.
                </div>
              </div>

              <!-- Schritt 1: Schnellscan laeuft -->
              <div class="kc-scan">
                <div class="kc-scan-eyebrow">Schneller NTFS-Scan</div>
                <div class="kc-count" data-count data-target="1284396">1.284.396</div>
                <div class="kc-scan-unit">Dateien gelesen</div>
                <div class="kc-scan-line">USN-Inventar: 184.213 Verzeichnisse auf C:\</div>
                <div class="kc-scan-track"><span></span></div>
              </div>

              <!-- Schritte 2 und 3: Treemap -->
              <div class="kc-map">
                {tiles.map((t, i) => (
                  <div
                    class={`kc-slot${t.dup ? ' is-dup' : ''}`}
                    style={`left:${t.x}%;top:${t.y}%;width:${t.w}%;height:${t.h}%`}
                  >
                    <div
                      class={`kc-tile${t.ink ? ' is-ink' : ''}${t.w <= 16 ? ' is-small' : ''}`}
                      style={`--i:${i};--c:${t.c};--shrink:${t.shrink ?? 1}`}
                    >
                      <span class="kc-tile-name">{t.n}</span>
                      <span class="kc-tile-size">{t.s}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="kc-stack kc-legend">
              <span data-s="0">Analysieren startet den Scan, der Report entsteht als eigene HTML-Datei.</span>
              <span data-s="1">Verzeichnisstruktur über das USN-Journal, Größen anschließend flach und parallel.</span>
              <span data-s="2"><i class="sw caution"></i>Duplikatgruppen, exakt byte-gleich</span>
              <span data-s="3"><i class="sw accent"></i>Durch Hardlinks ersetzt, Inhalt bleibt überall verfügbar</span>
            </div>
          </div>

          <!-- Rechte Karte: Duplikate + Bild-Duplikate -->
          <div class="kc-card kc-card-dup">
            <div class="kc-card-head">
              <span class="kc-h2">Duplikate</span>
              <span class="kc-stack kc-sum">
                <span data-s="0">Zuerst Duplikate suchen.</span>
                <span data-s="1">Zuerst Duplikate suchen.</span>
                <span data-s="2">37 Gruppen · 62,8 GB durch Kopien belegt</span>
                <span data-s="3">142 Duplikate durch Hardlinks ersetzt, 6 übersprungen, 58,3 GB gespart.</span>
              </span>
            </div>

            <div class="kc-dup-list">
              {dups.map((d, i) => (
                <div class="kc-dup" style={`--i:${i}`}>
                  <span class="kc-dup-head">
                    {d.head}
                    <span class="kc-dup-tag">verlinkt</span>
                  </span>
                  {d.files.map((f) => <span class="kc-dup-file">{f}</span>)}
                </div>
              ))}
            </div>

            <div class="kc-dup-action">
              <span class="kc-label">Behalten:</span>
              <span class="kc-combo">Erste Datei<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 6.5 3.5 3.5 3.5-3.5"/></svg></span>
              <span class="kc-btn kc-btn-small">Durch Hardlinks ersetzen</span>
            </div>

            <div class="kc-images">
              <span class="kc-h3">Bild-Duplikate</span>
              <span class="kc-stack kc-sum">
                <span data-s="0">Schwelle 5 · Unterordner</span>
                <span data-s="1">Schwelle 5 · Unterordner</span>
                <span data-s="2">9 Gruppen · 4,1 GB betroffen · Schwelle 5</span>
                <span data-s="3">9 Gruppen · 4,1 GB betroffen · Schwelle 5</span>
              </span>
              <span class="kc-images-hint">
                Visuell ähnlich, nicht byte-identisch: kein Hardlink, je Gruppe bleibt ein Bild, der Rest geht in den Papierkorb.
              </span>
            </div>
          </div>
        </div>

        <!-- Statusleiste -->
        <div class="kc-statusbar">
          <span class="kc-stack kc-status">
            <span data-s="0">Bereit.</span>
            <span data-s="1">Schneller NTFS-Scan…</span>
            <span data-s="2">Duplikatsuche fertig.</span>
            <span data-s="3">142 Duplikate durch Hardlinks ersetzt, 6 übersprungen, 58,3 GB gespart.</span>
          </span>
          <span class="kc-progress"><i></i></span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pv-kern-clean {
    /* Themes/Dark.xaml des echten Fensters */
    --pv-bg: #14181d;
    --pv-surface: #1c2229;
    --pv-surface-alt: #232b34;
    --pv-border: #2a323c;
    --pv-text: #e6ebf0;
    --pv-muted: #8a97a6;
    --pv-accent: #35c6a5;
    --pv-accent-dim: #2a9e85;
    --pv-accent-soft: #1e2e2c;
    --pv-caution: #e0a93b;
    --pv-on-accent: #0c1210;
    --pv-font: 'Segoe UI Variable Text', 'Segoe UI Variable Display', 'Segoe UI', system-ui, sans-serif;
    --pv-mono: 'Cascadia Mono', Consolas, ui-monospace, monospace;
    background: var(--pv-bg);
    color: var(--pv-text);
    font-family: var(--pv-font);
  }

  .kc-win { position: absolute; inset: 0; display: flex; flex-direction: column; }

  /* Titelleiste */
  .kc-title {
    flex: 0 0 auto;
    height: 3.2cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 3cqw;
    background: var(--pv-surface);
    border-bottom: 0.08cqw solid var(--pv-border);
  }
  .kc-title-text { font-size: 1.35cqw; color: var(--pv-muted); }
  .kc-chrome { display: flex; gap: 1.5cqw; }
  .kc-chrome i { width: 1cqw; height: 0.09cqw; background: var(--pv-muted); }
  .kc-chrome i:nth-child(2) { height: 0.9cqw; width: 0.9cqw; border: 0.09cqw solid var(--pv-muted); background: none; }
  .kc-chrome i.x {
    height: 0.9cqw; width: 0.9cqw; background: none;
    background-image: linear-gradient(45deg, transparent 44%, var(--pv-muted) 44% 56%, transparent 56%),
      linear-gradient(-45deg, transparent 44%, var(--pv-muted) 44% 56%, transparent 56%);
  }

  .kc-body { flex: 1 1 auto; min-height: 0; display: flex; }

  /* ===== Navigationsleiste (224 von 1080 im echten Fenster) ===== */
  .kc-nav {
    flex: 0 0 20.7%;
    background: var(--pv-surface);
    border-right: 0.08cqw solid var(--pv-border);
    padding: 1.8cqw 0 0;
    display: flex;
    flex-direction: column;
  }
  .kc-brand { display: flex; align-items: center; gap: 0.85cqw; padding: 0 1.6cqw; }
  .kc-mark { width: 1.7cqw; height: 1.7cqw; color: var(--pv-accent); }
  .kc-mark svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.4; }
  .kc-brand-name { font-size: 1.7cqw; font-weight: 600; letter-spacing: -0.01em; }
  .kc-version {
    padding: 0.4cqw 1.6cqw 0;
    font-size: 1.05cqw;
    color: var(--pv-muted);
    font-variant: all-small-caps;
    letter-spacing: 0.04em;
  }
  .kc-nav-list { margin-top: 1.4cqw; display: flex; flex-direction: column; gap: 0.12cqw; }
  .kc-nav-item {
    display: flex;
    align-items: center;
    margin: 0 0.75cqw;
    padding: 0.62cqw 0.55cqw;
    border-radius: 0.55cqw;
    color: var(--pv-muted);
  }
  .kc-nav-bar { width: 0.28cqw; height: 1.5cqw; border-radius: 0.2cqw; background: transparent; margin-right: 0.85cqw; }
  .kc-nav-icon { width: 1.45cqw; height: 1.45cqw; margin-right: 0.9cqw; flex: 0 0 auto; display: block; }
  .kc-nav-label { font-size: 1.25cqw; white-space: nowrap; }
  .kc-nav-item.is-active { background: var(--pv-accent-soft); color: var(--pv-text); }
  .kc-nav-item.is-active .kc-nav-bar { background: var(--pv-accent); }

  /* ===== Inhaltsspalte ===== */
  .kc-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
  .kc-head {
    padding: 2cqw 2.4cqw 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1cqw;
  }
  .kc-h1 { font-size: 2.6cqw; font-weight: 600; letter-spacing: -0.015em; }
  .kc-freed {
    font-family: var(--pv-mono);
    font-size: 1.3cqw;
    padding: 0.3cqw 0.85cqw;
    border-radius: 999px;
    background: var(--pv-accent-soft);
    color: var(--pv-accent);
    border: 0.08cqw solid var(--pv-accent-dim);
    opacity: 0;
    transform: scale(0.96);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  [data-step='3'] .kc-freed { opacity: 1; transform: none; }

  .kc-pathbar { display: flex; gap: 0.7cqw; padding: 1.3cqw 2.4cqw 0; }
  .kc-input {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 1.28cqw;
    padding: 0.55cqw 0.8cqw;
    border-radius: 0.4cqw;
    background: var(--pv-bg);
    border: 0.08cqw solid var(--pv-border);
    color: var(--pv-text);
    white-space: nowrap;
    overflow: hidden;
  }
  .kc-btn {
    flex: 0 0 auto;
    font-size: 1.28cqw;
    padding: 0.55cqw 1cqw;
    border-radius: 0.4cqw;
    border: 0.08cqw solid var(--pv-border);
    background: var(--pv-surface-alt);
    color: var(--pv-text);
    white-space: nowrap;
  }
  .kc-btn-primary { background: var(--pv-accent); border-color: var(--pv-accent); color: var(--pv-on-accent); font-weight: 600; position: relative; }
  .kc-btn-small { font-size: 1.15cqw; padding: 0.42cqw 0.8cqw; }

  .kc-options { display: flex; align-items: center; justify-content: space-between; gap: 1cqw; padding: 0.85cqw 2.4cqw 0; }
  .kc-check { display: flex; align-items: center; gap: 0.6cqw; font-size: 1.22cqw; color: var(--pv-text); }
  .kc-box {
    width: 1.25cqw; height: 1.25cqw; border-radius: 0.25cqw;
    background: var(--pv-accent); color: var(--pv-on-accent);
    display: flex; align-items: center; justify-content: center;
  }
  .kc-box svg { width: 84%; height: 84%; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  /* ===== Karten ===== */
  .kc-cards { flex: 1 1 auto; min-height: 0; display: flex; gap: 1cqw; padding: 1.2cqw 2.4cqw 0; }
  .kc-card {
    background: var(--pv-surface);
    border: 0.08cqw solid var(--pv-border);
    border-radius: 0.65cqw;
    padding: 1.15cqw;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .kc-card-map { flex: 1.62 1 0; min-width: 0; }
  .kc-card-dup { flex: 1 1 0; min-width: 0; }
  .kc-card-head { flex: 0 0 auto; display: flex; flex-direction: column; gap: 0.25cqw; margin-bottom: 0.8cqw; }
  .kc-h2 { font-size: 1.55cqw; font-weight: 600; }
  .kc-h3 { font-size: 1.35cqw; font-weight: 600; }

