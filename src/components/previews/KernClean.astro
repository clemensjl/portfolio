  /* Staffelung nur beim Eintritt in Schritt 2, der Austritt laeuft ohne Versatz. */
  [data-step='2'] .kc-tile { transition-delay: calc(var(--i) * 34ms); }
  [data-step='3'] .kc-slot.is-dup .kc-tile {
    transform: scale(var(--shrink));
    filter: saturate(0.22) brightness(0.72);
  }
  [data-step='2'] .kc-slot.is-dup { box-shadow: inset 0 0 0 0.24cqw var(--pv-caution); }
  [data-step='3'] .kc-slot.is-dup {
