    border-radius: 999px;
    background: var(--pv-accent);
    transform: translateX(-110%);
  }
  /* linear, weil die Schleifennaht bei einer Ease-Kurve sichtbar stockt. */
  .pv-kern-clean.is-live[data-step='1'] .kc-progress i {
    animation: kc-sweep 1.5s linear infinite;
  }

  /* Ruhender Zustand: der Startknopf atmet leicht */
  .kc-btn-primary::after {
    content: '';
