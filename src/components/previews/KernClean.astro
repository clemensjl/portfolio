  .kc-slot { position: absolute; border-radius: 0.55cqw; transition: box-shadow 300ms var(--ease-out), background-color 300ms var(--ease-out); }
  .kc-tile {
    position: absolute;
    inset: 0;
    margin: 0.13cqw;
    border-radius: 0.42cqw;
    background: var(--c);
    background: color-mix(in srgb, var(--c) 86%, #14181d);
    color: #ffffff;
    overflow: hidden;
    padding: 0.3cqw 0.42cqw;
