  [data-step='1'] .kc-drive, [data-step='2'] .kc-drive, [data-step='3'] .kc-drive { transform: scale(0.985); }
  [data-step='0'] .kc-scan { transform: scale(0.985); }

  /* Laufwerk mit Belegungsanzeige */
  .kc-drive { display: flex; flex-direction: column; justify-content: center; gap: 1cqw; padding: 0 0.3cqw; }
  .kc-drive-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1cqw; }
  .kc-drive-name { font-size: 1.6cqw; font-weight: 600; }
