  }
  .kc-status { font-size: 1.2cqw; color: var(--pv-muted); min-width: 0; }
  .kc-status > span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kc-progress {
    flex: 0 0 auto;
    width: 14cqw;
    height: 0.35cqw;
