  .kc-tile-name,
  .kc-tile-size { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.2; }
  .kc-tile-name { font-size: 1.3cqw; font-weight: 600; }
  .kc-tile-size { font-size: 1.15cqw; opacity: 0.86; font-variant-numeric: tabular-nums; }
  .kc-tile.is-small .kc-tile-name { font-size: 1.12cqw; }
  .kc-tile.is-small .kc-tile-size { font-size: 1.02cqw; }

  .kc-legend { flex: 0 0 auto; margin-top: 0.75cqw; font-size: 1.15cqw; color: var(--pv-muted); }
  .kc-legend > span { display: flex; align-items: center; gap: 0.5cqw; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kc-legend .sw { width: 0.85cqw; height: 0.85cqw; border-radius: 0.2cqw; flex: 0 0 auto; }
  .kc-legend .sw.caution { background: var(--pv-caution); }
  .kc-legend .sw.accent { background: var(--pv-accent); }

  /* ===== Duplikate ===== */
  .kc-dup-list { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 0.6cqw; overflow: hidden; }
  .kc-dup {
    opacity: 0;
    transform: translateY(0.5cqw);
    transition: opacity 280ms var(--ease-out), transform 280ms var(--ease-out);
  }
  [data-step='2'] .kc-dup, [data-step='3'] .kc-dup { opacity: 1; transform: none; }
  [data-step='2'] .kc-dup { transition-delay: calc(var(--i) * 70ms); }
  .kc-dup-head {
    display: flex;
    align-items: center;
    gap: 0.5cqw;
    font-family: var(--pv-mono);
    font-size: 1.22cqw;
    color: var(--pv-accent);
  }
  .kc-dup-tag {
    font-family: var(--pv-font);
    font-size: 1cqw;
    padding: 0.05cqw 0.45cqw;
    border-radius: 999px;
    background: var(--pv-accent-soft);
    color: var(--pv-accent);
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  [data-step='3'] .kc-dup-tag { opacity: 1; transform: none; }
  .kc-dup-file {
    display: block;
    font-size: 1.1cqw;
    color: var(--pv-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 260ms var(--ease-out);
  }
  [data-step='3'] .kc-dup-file + .kc-dup-file { opacity: 0.4; }

  .kc-dup-action { flex: 0 0 auto; display: flex; align-items: center; gap: 0.5cqw; margin-top: 0.75cqw; }
  .kc-label { font-size: 1.15cqw; color: var(--pv-muted); }
  .kc-combo {
    display: flex;
    align-items: center;
    gap: 0.35cqw;
    font-size: 1.15cqw;
    padding: 0.35cqw 0.55cqw;
    border-radius: 0.35cqw;
    background: var(--pv-bg);
    border: 0.08cqw solid var(--pv-border);
    white-space: nowrap;
  }
  .kc-combo svg { width: 1.1cqw; height: 1.1cqw; fill: none; stroke: var(--pv-muted); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .kc-images {
    flex: 0 0 auto;
    margin-top: 0.9cqw;
    padding-top: 0.8cqw;
    border-top: 0.08cqw solid var(--pv-border);
