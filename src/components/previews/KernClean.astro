  }
  @keyframes kc-pulse {
    0%, 100% { opacity: 0; transform: scale(0.97); }
    45% { opacity: 0.55; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-kern-clean.is-live .kc-scan-track > span,
    .pv-kern-clean.is-live .kc-progress i,
    .pv-kern-clean.is-live .kc-btn-primary::after { animation: none; }
    .kc-scan-track > span, .kc-progress i { transform: translateX(-10%); }
  }
</style>

<script>
  // Zaehler des Schnellscans: CSS kann keine Ziffern hochzaehlen.
  // Endzustand steht im HTML, das Skript animiert nur den Weg dorthin.
  const nf = new Intl.NumberFormat('de-DE');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('.pv-kern-clean').forEach((pv) => {
    const el = pv.querySelector<HTMLElement>('[data-count]');
    if (!el) return;
    const target = Number(el.dataset.target || 0);
    let raf = 0;
    let t0 = 0;

    const stop = () => { if (raf) cancelAnimationFrame(raf); raf = 0; };
    const settle = () => { stop(); el.textContent = nf.format(target); };

    const tick = (t: number) => {
      if (!t0) t0 = t;
      const p = Math.min(1, (t - t0) / 1400);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = nf.format(Math.round(target * eased));
      if (p < 1) raf = requestAnimationFrame(tick); else raf = 0;
    };

    const sync = () => {
      const running = pv.dataset.step === '1' && pv.classList.contains('is-live');
      if (!running || reduce.matches) { settle(); return; }
      if (raf) return;
      t0 = 0;
      el.textContent = '0';
      raf = requestAnimationFrame(tick);
    };

    new MutationObserver(sync).observe(pv, { attributes: true, attributeFilter: ['class', 'data-step'] });
    sync();
  });
</script>
