---
// Vorschau: Maerchenfuchs (Flutter-App fuer personalisierte Gutenachtgeschichten).
//
// Schritt 0: Der "Heute"-Screen mit der Nachthimmel-Karte, dem schlafenden Fuchsi,
//            dem Titel der heutigen Geschichte und dem Amber-Button "Vorlesen".
// Schritt 1: Die Eltern legen das Kind-Profil an: Name, Alter, Lieblings-Themen
//            werden als Chips ausgewaehlt.
// Schritt 2: Fuchsi schreibt: die Arbeitsschritte haken sich ab, die Geschichte
//            erscheint Zeile fuer Zeile in der Serifenschrift.
// Schritt 3: Vorlese-Modus: gedimmter Nachthimmel, laufender Fortschrittsbalken,
//            Schlummer-Timer und der wache, winkende Fuchsi.
//
// Farben, Radien und Texte stammen aus dem echten Repo (app_theme.dart,
// home_page.dart, kid_profile_form.dart, create_kid_page.dart, generating_view.dart,
// audio_player_bar.dart). Die Display-Schrift der App (Fraunces) wird bewusst NICHT
// geladen; Georgia dient als Annaeherung. Die App-Oberflaeche ist einsprachig
// deutsch, deshalb bleiben ihre Labels deutsch; nur die Geschichte selbst und das
// aria-label folgen der Sprach-Prop.

interface Props { lang?: 'de' | 'en' }
const { lang = 'de' } = Astro.props;

const T = {
  de: {
    aria:
      'Vorschau der Maerchenfuchs-App: Nachthimmel-Karte mit schlafendem Fuchs, ' +
      'Kind-Profil mit Lieblings-Themen, entstehende Geschichte und Vorlese-Modus.',
    story: [
      'Mira kletterte auf die Wolkenschaukel und stieß sich ganz sanft ab.',
      'Unter ihr blinkten die kleinen Lichter der schlafenden Stadt.',
      'Ein Stern setzte sich neben sie und summte ein leises Lied.',
    ],
    rest: [
      'Die Wolken trugen die beiden über sieben stille Dächer.',
      'Dann wurde die Schaukel langsam, ganz langsam.',
    ],
  },
  en: {
    aria:
      'Preview of the Maerchenfuchs app: night sky card with a sleeping fox, ' +
      'child profile with favourite topics, a story being written and reading mode.',
    story: [
      'Mira climbed onto the cloud swing and pushed off very gently.',
      'Below her the small lights of the sleeping town were blinking.',
      'A star sat down beside her and hummed a quiet little song.',
    ],
    rest: [
      'The clouds carried them both over seven quiet rooftops.',
      'Then the swing grew slow, very slow.',
    ],
  },
}[lang];

// Deterministischer Sternenhimmel (die echte App malt ihn ebenfalls deterministisch).
function stars(seed: number, count: number, w: number, h: number) {
  let s = seed;
  const rnd = () => ((s = (s * 1103515245 + 12345) % 2147483648) / 2147483648);
  return Array.from({ length: count }, () => ({
    x: +(rnd() * w).toFixed(2),
    y: +(rnd() * h).toFixed(2),
    r: +(0.5 + rnd() * 1.4).toFixed(2),
    o: +(0.28 + rnd() * 0.6).toFixed(2),
  }));
}
const skyStars = stars(7, 70, 100, 62);
const heroStars = stars(26, 26, 100, 46);
const readStars = stars(91, 26, 100, 170);

const kid = 'Mira';
const teaser = 'Die Reise auf der Wolkenschaukel';
const themes = ['Tiere', 'Dinosaurier', 'Weltraum', 'Ritter', 'Meer', 'Wald', 'Freundschaft', 'Abenteuer', 'Magie'];
// Reihenfolge der Auswahl. Die Chips staffeln ueber diese Position (0, 1, 2),
// nicht ueber ihren Platz im Themen-Array.
const pickOrder = ['Tiere', 'Weltraum', 'Freundschaft'];
const picked = new Set(pickOrder);
const steps = [
  'Fuchsi sucht einen verwunschenen Ort',
  'und findet dich mitten darin',
  'webt gerade die Magie',
];
const shelf = [
  { t: 'Der kleine Leuchtturm am stillen Meer', c: '#4FB0F0' },
  { t: 'Das Geheimnis im Glühwürmchenwald', c: '#2FBFA0' },
  { t: 'Eine Nacht im Baumhaus der Sterne', c: '#9B6BE0' },
  { t: 'Das Karussell aus Mondlicht', c: '#FFC93C' },
];
---

<div class="pv pv-mf" data-preview data-step="0" role="img" aria-label={T.aria}>
  <!-- Bedtime-Buehne: Nachtverlauf, gemalter Sternenhimmel, Amber-Horizont -->
  <div class="sky">
    <svg class="sky-stars" viewBox="0 0 100 62" preserveAspectRatio="none" aria-hidden="true">
      {skyStars.map((s) => <circle cx={s.x} cy={s.y} r={s.r * 0.19} fill="#F4E5C3" opacity={s.o} />)}
    </svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.2 3.6a9 9 0 1 0 3.2 12.2A10 10 0 0 1 17.2 3.6Z" fill="#F4E5C3" opacity="0.8" />
    </svg>
    <span class="glow"></span>
  </div>

  <!-- Zweites, angeschnittenes Geraet: Bibliothek, ruhig im Hintergrund -->
  <div class="phone phone-b">
    <div class="screen">
      <div class="sc sc-day is-static">
        <div class="statusbar"><span>20:15</span><span class="sbdots"><i></i><i></i><i></i></span></div>
        <p class="sec">Zuletzt gelesen</p>
        <div class="shelf">
          {shelf.map((b) => (
            <div class="book">
              <span class="cover" style={`--c:${b.c}`}></span>
              <span class="btitle">{b.t}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Haupt-Geraet: erzaehlt die vier Schritte -->
  <div class="phone phone-a">
    <div class="screen">
      <!-- 0 Heute -->
      <div class="sc sc-day" data-sc="0">
        <div class="statusbar"><span>20:15</span><span class="sbdots"><i></i><i></i><i></i></span></div>
        <div class="topbar">
          <span class="kidchip"><i class="av"></i>{kid}</span>
          <span class="streak">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2c.6 3.4-1.4 4.6-2.8 6.3C8.5 10.4 8 12 8 13.6A6 6 0 0 0 20 14c0-4-2.6-5.6-3.4-7.2-.6 1-.2 2.6-1.3 3.2C14.6 8 14.6 4.5 13 2Z" fill="currentColor"/><path d="M11.4 13.4c-1.6 1.2-2 2.2-2 3.2a2.6 2.6 0 0 0 5.2 0c0-1.2-1-2-1.5-3-.5.8-.4 1.8-1.7 1.9Z" fill="#FFF8EF" opacity=".55"/></svg>
            4
          </span>
        </div>

        <div class="hero">
          <svg class="hero-stars" viewBox="0 0 100 70" preserveAspectRatio="none" aria-hidden="true">
            {heroStars.map((s) => <circle cx={s.x} cy={s.y} r={s.r * 0.42} fill="#F4E5C3" opacity={s.o} />)}
          </svg>
          <span class="hero-glow"></span>
          <img class="fox fox-sleep" src="/images/previews/maerchenfuchs/fuchsi-sleep.png" width="260" height="260" alt="" loading="lazy" decoding="async" />
          <p class="over">Fuchsi hat für heute Abend etwas vorbereitet</p>
          <p class="htitle">&#187;{teaser}&#171;</p>
          <p class="meta">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.6V12l3 1.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            ca. 10 Min &middot; zum Einschlafen
          </p>
          <p class="sub">Tippen, dann erzählt Fuchsi sie {kid}.</p>
          <span class="cta">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5 18.5 12 8 18.5Z" fill="currentColor"/></svg>
            Vorlesen
          </span>
        </div>

        <div class="goal">
          <span class="ring"></span>
          <span class="goaltext">
            <b>Bereit fürs Tagesziel</b>
            <i>Eine Geschichte heute Abend füllt den Ring.</i>
          </span>
        </div>

        <p class="sec">Schnell loslegen</p>
        <div class="tiles">
          <span class="tile" style="--c:#9B6BE0">Überrasch mich</span>
          <span class="tile" style="--c:#FF6B6B">Abenteuer</span>
          <span class="tile" style="--c:#4FB0F0">Weltraum</span>
          <span class="tile" style="--c:#2FBFA0">Dinos</span>
        </div>

        <p class="sec">Zuletzt gelesen</p>
        <div class="shelf">
          {shelf.slice(0, 2).map((b) => (
            <div class="book">
              <span class="cover" style={`--c:${b.c}`}></span>
              <span class="btitle">{b.t}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 1 Kind-Profil -->
      <div class="sc sc-day" data-sc="1">
        <div class="statusbar"><span>20:15</span><span class="sbdots"><i></i><i></i><i></i></span></div>
        <div class="wizhead">
          <div>
            <p class="wiztitle">Kind hinzufügen</p>
            <p class="wizsub">Erzähl uns von deinem Kind</p>
          </div>
          <span class="dots">
            <i style="--c:#FF6B6B"></i><i style="--c:#4FB0F0" class="on"></i><i style="--c:#2FBFA0"></i><i style="--c:#9B6BE0"></i><i style="--c:#FFC93C"></i>
          </span>
        </div>

        <p class="flabel">Name</p>
        <div class="field"><span>{kid}</span><i class="caret"></i></div>

        <p class="flabel row">Alter <b>6 Jahre</b></p>
        <div class="slider"><span class="track"></span><span class="fill"></span><span class="knob"></span></div>

        <p class="flabel">Lieblings-Themen</p>
        <div class="chips">
          {themes.map((t, i) => (
            <span
              class:list={['chip', picked.has(t) && 'sel']}
              style={`--i:${i};--pick:${pickOrder.indexOf(t)}`}
            >{t}</span>
          ))}
        </div>

        <span class="spacer"></span>
        <p class="hint">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5.5c0 4.2 2.9 7.7 7 9 4.1-1.3 7-4.8 7-9V6Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
          Nur Vornamen und Alltägliches. So bleiben die Daten deines Kindes geschützt.
        </p>
        <span class="btn-bevel">Weiter</span>
      </div>

      <!-- 2 Geschichte entsteht -->
      <div class="sc sc-night" data-sc="2">
        <div class="statusbar sb-night"><span>20:16</span><span class="sbdots"><i></i><i></i><i></i></span></div>
        <p class="genhead">Fuchsi webt eine Geschichte für {kid} &hellip;</p>
        <div class="ticks">
          {steps.map((s, i) => (
            <span class="tick" style={`--i:${i}`}>
              <i class="box"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.6 4.4 4.4L19 7.4" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></i>
              {s}
            </span>
          ))}
        </div>
        <div class="gencard">
          <p class="gentitle">&#187;{teaser}&#171;</p>
          <div class="lines">
            {T.story.map((l, i) => <p class="line" style={`--i:${i}`}>{l}</p>)}
            <span class="pen"></span>
          </div>
        </div>
      </div>

      <!-- 3 Vorlese-Modus -->
      <div class="sc sc-read" data-sc="3">
        <svg class="read-stars" viewBox="0 0 100 170" preserveAspectRatio="none" aria-hidden="true">
          {readStars.map((s) => <circle cx={s.x} cy={s.y} r={s.r * 0.6} fill="#F4E5C3" opacity={s.o * 0.7} />)}
        </svg>
        <div class="statusbar sb-night"><span>20:19</span><span class="sbdots"><i></i><i></i><i></i></span></div>
        <p class="readtitle">{teaser}</p>
        <div class="readbody">
          <p class="rline">{T.story[0]}</p>
          <p class="rline now">{T.story[1]}</p>
          <p class="rline">{T.story[2]}</p>
          {T.rest.map((l) => <p class="rline">{l}</p>)}
        </div>
        <img class="fox fox-wave" src="/images/previews/maerchenfuchs/fuchsi-wave.png" width="260" height="260" alt="" loading="lazy" decoding="async" />
        <div class="player">
          <span class="ptop">
            <span class="pbtn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="5" width="3.6" height="14" rx="1.4" fill="currentColor"/><rect x="13.4" y="5" width="3.6" height="14" rx="1.4" fill="currentColor"/></svg>
            </span>
            <span class="pcol">
              <span class="pbar"><i class="pfill"></i></span>
              <span class="ptimes"><span>3:47</span><span>9:52</span></span>
            </span>
          </span>
          <span class="sleeptimer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.2 3.6a9 9 0 1 0 3.2 12.2A10 10 0 0 1 17.2 3.6Z" fill="currentColor"/></svg>
            Schlummer-Timer
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .pv-mf {
    --mf-primary: #e8913c;
    --mf-bevel: #7a3f18;
    --mf-secondary: #2d1b47;
    --mf-accent: #f4e5c3;
    --mf-day: #fff8ef;
    --mf-on-night: #fbf4e6;
    --mf-ink: #3a2a4d;
    --mf-ink-soft: #736485;
    --mf-line: #ece6f2;
    --mf-coral: #ff6b6b;
    --mf-mint: #2fbfa0;
    --mf-serif: Georgia, 'Times New Roman', serif;
    background: linear-gradient(168deg, #2b1a3d 0%, #1e1230 52%, #130c1d 100%);
    font-family: var(--font-sans);
    color: var(--mf-ink);
  }

  /* --- Buehne ------------------------------------------------------------ */
  .sky { position: absolute; inset: 0; }
  .sky-stars { position: absolute; inset: 0; width: 100%; height: 100%; }
  .moon { position: absolute; right: 2.6cqw; top: 3.6cqw; width: 6cqw; height: 6cqw; }
  .glow {
    position: absolute;
    left: -10cqw; right: -10cqw; bottom: -24cqw; height: 42cqw;
    background: radial-gradient(58% 100% at 56% 100%, rgb(232 145 60 / 0.34), rgb(232 145 60 / 0) 70%);
    opacity: 0.85;
  }
  .pv-mf.is-live .glow { animation: mf-breathe 7s var(--ease-in-out) infinite alternate; }
  @keyframes mf-breathe { from { opacity: 0.58; transform: scale(0.97); } to { opacity: 0.95; transform: scale(1); } }

  /* --- Geraete ----------------------------------------------------------- */
  .phone {
    position: absolute;
    border-radius: 4.6cqw;
    padding: 0.8cqw;
    background: linear-gradient(160deg, #40285a, #1b1027);
  }
  .phone-a {
    left: 5.5cqw; top: 3cqw; width: 37cqw; height: 61cqw; z-index: 2;
    box-shadow: inset 0 0 0 0.16cqw rgb(244 229 195 / 0.24), 0 4cqw 8cqw -2cqw rgb(10 5 18 / 0.8);
  }
  .phone-b {
    left: 55cqw; top: 7.5cqw; width: 34cqw; height: 58cqw; z-index: 1;
    transform: rotate(6deg); opacity: 0.5; filter: saturate(0.8);
    box-shadow: inset 0 0 0 0.16cqw rgb(244 229 195 / 0.16), 0 3cqw 6cqw -2cqw rgb(10 5 18 / 0.7);
  }
  .screen {
    position: relative; width: 100%; height: 100%;
    border-radius: 3.9cqw; overflow: hidden;
    background: #1d1228;
  }

  .sc {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    padding: 0.9cqw 1.5cqw 0;
    opacity: 0;
    transform: translateY(1.4cqw) scale(0.985);
    transition: opacity 340ms var(--ease-out), transform 420ms var(--ease-out);
  }
  .sc > * { flex-shrink: 0; }
  .sc.is-static { opacity: 1; transform: none; }
  .sc-day { background: linear-gradient(180deg, #fff8ef 0%, #ffefe0 62%, #ffe7d2 100%); }
  .sc-night { background: linear-gradient(172deg, #4a2e54 0%, #3d2648 40%, #33203d 70%, #2a1a34 100%); color: var(--mf-on-night); }
  .sc-read { background: linear-gradient(170deg, #3b2648, #2a1a38 55%, #1d1228); color: var(--mf-on-night); }
  .pv-mf[data-step='0'] [data-sc='0'],
  .pv-mf[data-step='1'] [data-sc='1'],
  .pv-mf[data-step='2'] [data-sc='2'],
  .pv-mf[data-step='3'] [data-sc='3'] { opacity: 1; transform: none; }

  .statusbar {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 1.1cqw; font-weight: 650; color: var(--mf-ink);
    padding: 0.15cqw 0.8cqw 0.85cqw;
  }
  .sb-night { color: rgb(251 244 230 / 0.85); position: relative; }
  .sbdots { display: flex; gap: 0.32cqw; }
  .sbdots i { width: 0.58cqw; height: 0.58cqw; border-radius: 50%; background: currentColor; opacity: 0.55; }

  /* --- 0 Heute ----------------------------------------------------------- */
  .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1cqw; }
  .kidchip {
    display: inline-flex; align-items: center; gap: 0.5cqw;
    background: #fff; border: 0.13cqw solid var(--mf-line);
    border-radius: 999px; padding: 0.4cqw 0.95cqw 0.4cqw 0.4cqw;
    font-size: 1.25cqw; font-weight: 650; color: var(--mf-ink);
  }
  .kidchip .av { width: 1.6cqw; height: 1.6cqw; border-radius: 50%; background: linear-gradient(140deg, #ffc93c, #ff6b6b); }
  .streak {
    display: inline-flex; align-items: center; gap: 0.3cqw;
    background: rgb(255 107 107 / 0.16); color: var(--mf-coral);
    border-radius: 999px; padding: 0.38cqw 0.85cqw 0.38cqw 0.6cqw;
    font-size: 1.25cqw; font-weight: 750;
  }
  .streak svg { width: 1.45cqw; height: 1.45cqw; }

  .hero {
    position: relative; overflow: hidden;
    border-radius: 2.7cqw;
    background: linear-gradient(168deg, #4a2e54, #382242 56%, #26172f);
    padding: 1.35cqw 1.4cqw 1.3cqw;
    color: var(--mf-on-night);
    box-shadow: 0 1.2cqw 2.4cqw -1cqw rgb(20 10 34 / 0.6);
  }
  .hero-stars { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-glow {
    position: absolute; left: -6%; right: -6%; bottom: -5cqw; height: 11cqw;
    background: radial-gradient(60% 100% at 50% 100%, rgb(232 145 60 / 0.55), rgb(232 145 60 / 0) 72%);
  }
  .fox { position: absolute; width: 8.6cqw; height: auto; }
  .fox-sleep { right: 0.7cqw; bottom: -0.3cqw; }
  .hero > p, .hero > .cta { position: relative; }
  .over { font-size: 1.12cqw; font-weight: 700; margin: 0 0 0.4cqw; color: rgb(251 244 230 / 0.9); }
  .htitle {
    font-family: var(--mf-serif);
    font-size: 2.1cqw; line-height: 1.18; font-weight: 700; color: #fff;
    margin: 0 0 0.5cqw; padding-right: 0.5cqw;
  }
  .meta {
    display: flex; align-items: center; gap: 0.4cqw;
    font-size: 1.1cqw; margin: 0 0 0.45cqw; color: rgb(251 244 230 / 0.88);
  }
  .meta svg { width: 1.25cqw; height: 1.25cqw; flex: none; }
  .sub { font-size: 1.2cqw; margin: 0 0 1cqw; padding-right: 8cqw; color: rgb(251 244 230 / 0.94); }
  .cta {
    display: inline-flex; align-items: center; gap: 0.45cqw;
    background: var(--mf-primary); color: var(--mf-secondary);
    border-radius: 999px; padding: 0.55cqw 1.25cqw;
    font-size: 1.32cqw; font-weight: 800;
    box-shadow: 0 0.36cqw 0 var(--mf-bevel);
  }
  .cta svg { width: 1.32cqw; height: 1.32cqw; }

  .goal {
    display: flex; align-items: center; gap: 0.85cqw;
    background: #fff; border: 0.13cqw solid var(--mf-line);
    border-radius: 2cqw; padding: 0.85cqw 1cqw; margin-top: 1.1cqw;
  }
  .ring {
    width: 2.9cqw; height: 2.9cqw; border-radius: 50%; flex: none;
    background: conic-gradient(var(--mf-mint) 0 32%, var(--mf-line) 32% 100%);
    -webkit-mask: radial-gradient(circle, transparent 46%, #000 48%);
    mask: radial-gradient(circle, transparent 46%, #000 48%);
  }
  .goaltext { display: grid; gap: 0.12cqw; }
  .goaltext b { font-size: 1.24cqw; font-weight: 700; }
  .goaltext i { font-size: 1.08cqw; font-style: normal; color: var(--mf-ink-soft); }

  .sec { font-size: 1.24cqw; font-weight: 750; margin: 1.15cqw 0 0.7cqw; color: var(--mf-ink); }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7cqw; }
  .tile {
    background: color-mix(in srgb, var(--c) 18%, #fff);
    border: 0.13cqw solid color-mix(in srgb, var(--c) 40%, #fff);
    border-radius: 1.6cqw; padding: 0.8cqw 0.9cqw;
    font-size: 1.14cqw; font-weight: 700; color: var(--mf-ink);
  }

  /* --- 1 Kind-Profil ------------------------------------------------------ */
  .wizhead { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.2cqw; }
  .wiztitle { font-size: 1.68cqw; font-weight: 750; margin: 0; }
  .wizsub { font-size: 1.1cqw; margin: 0.18cqw 0 0; color: var(--mf-ink-soft); }
  .dots { display: flex; gap: 0.4cqw; padding-top: 0.5cqw; }
  .dots i { width: 0.8cqw; height: 0.8cqw; border-radius: 50%; background: var(--c); opacity: 0.3; }
  .dots i.on { opacity: 1; transform: scale(1.25); }

  .flabel { font-size: 1.2cqw; font-weight: 700; margin: 0 0 0.5cqw; color: var(--mf-ink); }
  .flabel.row { display: flex; justify-content: space-between; margin-top: 1.25cqw; }
  .flabel b { color: var(--mf-ink-soft); font-weight: 650; }
  .field {
    display: flex; align-items: center;
    background: #fff; border: 0.15cqw solid var(--mf-line);
    border-radius: 1.5cqw; padding: 0.75cqw 1.05cqw; font-size: 1.36cqw; font-weight: 600;
