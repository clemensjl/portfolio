---
// Vorschau: Agent Deck (Windows-Cockpit fuer Coding-Agenten).
// Farben, Radien, Labels aus dem echten Repo (src/renderer/src/assets/base.css,
// main.css, Sidebar.tsx, TabBar.tsx, QuestionDialog.tsx). Design "Instrument Panel":
// tiefes Chassis #0a0d12, Copper-Amber #ff9d54, Signaturmotiv "vital pulse".
//
// Schritt 0: Das Cockpit steht. Sidebar mit Projekten und Profilfarben, vier
//            Terminal-Panes, in denen Claude Code, Codex CLI, Grok CLI und
//            OpenCode an je einem Projekt arbeiten.
// Schritt 1: Alle vier laufen parallel weiter, neue Ausgabezeilen erscheinen
//            gestaffelt, die Statusanzeigen wechseln zwischen arbeitet und fertig.
// Schritt 2: Grok CLI stellt eine Zwischenfrage. Der Dialog sitzt inline im Pane
//            der fragenden Session, das Pane tritt hervor, die Sidebar markiert sie.
// Schritt 3: Option 1 wird gewaehlt, der Dialog schliesst, die Session schreibt
//            weiter, alle vier Sessions sind wieder aktiv.

interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;

const T = {
  de: {
    aria:
      'Vorschau von Agent Deck: vier Terminal-Panes mit parallel laufenden Coding-Agenten, in einem erscheint eine Zwischenfrage mit nummerierten Antwortoptionen, die beantwortet wird.',
  },
  en: {
    aria:
      'Preview of Agent Deck: four terminal panes running coding agents in parallel, one shows an inline question dialog with numbered answer options that gets answered.',
  },
}[lang];

// Profilfarben exakt aus Sidebar.tsx (rost, stahlblau, messing, moos)
const panes = [
  {
    id: 'p1',
    agent: 'Claude Code',
    project: 'agent-deck',
    color: '#e05d38',
    st: ['arbeitet', 'fertig', 'fertig', 'arbeitet'],
    lines: [
      { t: 'claude --continue', k: 'shell' },
      { t: 'Profil Privat, 41k Kontext', k: 'dim' },
      { t: '> PTY-Umbau absichern', k: 'cmd' },
      { t: 'Read src/main/pty.ts', k: 'tool' },
      { t: 'Read src/main/session.ts', k: 'tool' },
      { t: 'Edit src/main/pty.ts', k: 'tool' },
      { t: '+ await session.dispose()', k: 'add' },
      { t: '- session.kill()', k: 'del', cur: '0' },
      { t: 'Bash npm test', k: 'tool', at: '1' },
      { t: '805 Tests, 0 Fehler', k: 'ok', at: '1', cur: '1' },
    ],
  },
  {
    id: 'p2',
    agent: 'Codex CLI',
    project: 'portfolio',
    color: '#4fb0c6',
    st: ['arbeitet', 'arbeitet', 'arbeitet', 'arbeitet'],
    lines: [
      { t: 'codex', k: 'shell' },
      { t: 'Profil Arbeit', k: 'dim' },
      { t: '> Kopfzeile umbauen', k: 'cmd' },
      { t: 'apply_patch Header.astro', k: 'tool' },
      { t: '+ <nav class="nav" data-nav>', k: 'add' },
      { t: '- <nav class="nav">', k: 'del' },
      { t: 'apply_patch Base.astro', k: 'tool' },
      { t: '+ <slot name="head" />', k: 'add', cur: '0' },
      { t: 'astro check', k: 'tool', at: '1' },
      { t: '0 Fehler, 2 Hinweise', k: 'ok', at: '1', cur: '1' },
    ],
  },
  {
    id: 'p3',
    agent: 'Grok CLI',
    project: 'agentfenster',
    color: '#c9a24b',
    ask: true,
    st: ['arbeitet', 'arbeitet', 'Zwischenfrage', 'arbeitet'],
    lines: [
      { t: 'grok', k: 'shell' },
      { t: 'Profil Review', k: 'dim' },
      { t: '> Werkzeugliste prüfen', k: 'cmd' },
      { t: 'grep WERKZEUG_ORDNUNG mcp.py', k: 'tool' },
      { t: 'mcp.py:145', k: 'dim' },
      { t: 'list_windows, read_desktop,', k: 'dim', cur: '0' },
      { t: '13 Werkzeuge registriert', k: 'ok', at: '1' },
      { t: 'README nennt 11', k: 'dim', at: '1', cur: '1' },
      { t: 'Antwort: Ja, Liste ersetzen', k: 'cmd', at: '3' },
      { t: 'Edit README.md', k: 'tool', at: '3', cur: '3' },
    ],
  },
  {
    id: 'p4',
    agent: 'OpenCode',
    project: 'kernmind',
    color: '#5fa87a',
    st: ['bereit', 'arbeitet', 'arbeitet', 'arbeitet'],
    lines: [
      { t: 'opencode', k: 'shell' },
      { t: 'Profil Test', k: 'dim' },
      { t: '> Provider zählen', k: 'cmd' },
      { t: 'read lib/types.ts', k: 'tool' },
      { t: 'read lib/ai.ts', k: 'tool' },
      { t: 'gemini, openai, groq,', k: 'dim' },
      { t: 'openrouter, claude, ollama', k: 'dim', cur: '0' },
      { t: '6 BYOK, 1 Offline-Fallback', k: 'ok', at: '1' },
      { t: 'local_heuristic ohne Key', k: 'dim', at: '1', cur: '1' },
    ],
  },
];

const projects = ['agent-deck', 'portfolio', 'agentfenster', 'kernmind'];
const profiles = [
  { n: 'Privat', c: '#e05d38' },
  { n: 'Arbeit', c: '#4fb0c6' },
  { n: 'Review', c: '#c9a24b' },
  { n: 'Test', c: '#5fa87a' },
];
---

<div class="pv pv-agent-deck" data-preview data-step="0" role="img" aria-label={T.aria}>
  <div class="ad-win">
    <!-- Sidebar -->
    <div class="ad-side">
      <div class="ad-brand">
        <span class="ad-pulse" style="color:#ff9d54"><i class="ad-ring"></i><i class="ad-core"></i></span>
        <span class="ad-brand-txt">
          <span class="ad-word">Agent Deck<span class="ad-ver">v3.5.0</span></span>
          <span class="ad-readout"><span class="ad-r3">3 AKTIV</span><span class="ad-r4">4 AKTIV</span></span>
        </span>
      </div>

      <div class="ad-newbtn"><span class="ad-plus">+</span>Neue Session</div>

      <div class="ad-nav">
        <span class="ad-navi is-on">Sessions</span>
        <span class="ad-navi">Verlauf</span>
        <span class="ad-navi">Graph</span>
      </div>

      <div class="ad-sec">
        <span class="ad-head">Ansicht</span>
        <span class="ad-view is-on"><span class="ad-vl">Alle Sessions</span></span>
        {projects.map((p) => (
          <span class={`ad-view${p === 'agentfenster' ? ' ad-view--wait' : ''}`}>
            <span class="ad-vl">{p}</span>
            {p === 'agentfenster' && <span class="ad-badge">1</span>}
          </span>
        ))}
      </div>

      <div class="ad-sec">
        <span class="ad-head">Profile</span>
        {profiles.map((p) => (
          <span class="ad-prof"><i class="ad-dot" style={`background:${p.c}`}></i><span class="ad-vl">{p.n}</span></span>
        ))}
      </div>

      <div class="ad-foot">
        <span class="ad-view"><span class="ad-vl">Tutorials</span><span class="ad-badge">2</span></span>
        <span class="ad-view"><span class="ad-vl">Skills</span></span>
        <span class="ad-view"><span class="ad-vl">Kosten</span></span>
      </div>
    </div>

    <!-- Hauptbereich -->
    <div class="ad-main">
      <div class="ad-tabs">
        {panes.map((p, i) => (
          <span class={`ad-tab${i === 0 ? ' is-on' : ''}`} style={`--c:${p.color}`}>
            {i === 0 && <i class="ad-tabind"></i>}
            <span class="ad-pulse" style={`color:${p.color}`}><i class="ad-ring"></i><i class="ad-core"></i></span>
            <span class="ad-tabt">{p.project}</span>
          </span>
        ))}
      </div>

      <div class="ad-grid">
        {panes.map((p, pi) => (
          <div class={`ad-pane${p.ask ? ' ad-pane--ask' : ''}`} data-p={pi} style={`--c:${p.color}`}>
            <div class="ad-ph">
              <span class="ad-pulse" style={`color:${p.color}`}><i class="ad-ring"></i><i class="ad-core"></i></span>
              <span class="ad-pagent">{p.agent}</span>
              <span class="ad-pcwd">{p.project}</span>
              <span class="ad-status">
                {p.st.map((s, n) => (
                  <span class={`ad-s${n}${s === 'fertig' || s === 'Zwischenfrage' ? ' is-mark' : ''}`}>{s}</span>
                ))}
              </span>
            </div>
            <div class="ad-body">
              {p.lines.map((l, i) => (
                <span
                  class={`ad-line is-${l.k}`}
                  data-at={l.at}
                  style={`--d:${i}`}
                >{l.t}{l.cur && <i class="ad-cur" data-cur={l.cur}></i>}</span>
              ))}
            </div>

            {p.ask && (
              <div class="ad-qov">
                <div class="ad-dialog">
                  <div class="ad-dhead">
                    <span class="ad-dtitle">Zwischenfrage</span>
                    <span class="ad-dx">×</span>
                  </div>
                  <span class="ad-qtext">Werkzeugliste im README auf 13 anheben?</span>
                  <div class="ad-qopts">
                    <span class="ad-qrow is-pick"><i class="ad-qi">1</i>Ja, Liste ersetzen<i class="ad-tap"></i></span>
                    <span class="ad-qrow"><i class="ad-qi">2</i>Erst Diff zeigen</span>
                    <span class="ad-qrow"><i class="ad-qi">3</i>Nein, später</span>
                  </div>
                  <span class="ad-dlabel">Oder eigene Antwort</span>
                  <div class="ad-qin">
                    <span class="ad-field">Antwort eintippen …</span>
                    <span class="ad-dbtn">Antworten</span>
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* ---- Tokens aus agent-deck/src/renderer/src/assets/base.css ---- */
  .pv-agent-deck {
    --pv-bg: #0a0d12;
    --pv-panel: #11151d;
    --pv-raised: #171d27;
    --pv-hover: #1e2531;
    --pv-border: #232a35;
    --pv-border-strong: #333d4c;
    --pv-glow: rgba(255, 157, 84, 0.35);
    --pv-text: #eaeef4;
    --pv-dim: #8d97a8;
    --pv-faint: #57626f;
    --pv-accent: #ff9d54;
    --pv-accent-strong: #ffb578;
    --pv-accent-soft: rgba(255, 157, 84, 0.16);
    --pv-ui: 'Manrope Variable', 'Segoe UI', system-ui, sans-serif;
    --pv-r-sm: 1.1cqw;
    --pv-r-md: 1.7cqw;
    background: var(--pv-bg);
    font-family: var(--pv-ui);
    color: var(--pv-text);
  }

  .ad-win {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 24cqw 1fr;
  }

  /* ---------- Sidebar ---------- */
  .ad-side {
    background: var(--pv-panel);
    border-right: 0.12cqw solid var(--pv-border);
    padding: 1.1cqw 1.1cqw 0.9cqw;
    display: flex;
    flex-direction: column;
    gap: 0.85cqw;
    min-height: 0;
    overflow: hidden;
  }

  .ad-brand { display: flex; align-items: center; gap: 0.8cqw; }
  .ad-brand-txt { display: flex; flex-direction: column; gap: 0.1cqw; min-width: 0; }
  .ad-word {
    font-family: var(--font-display);
    font-size: 1.85cqw;
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .ad-ver {
    font-family: var(--font-mono);
    font-size: 1.15cqw;
    color: var(--pv-faint);
    margin-left: 0.6cqw;
    letter-spacing: 0.02em;
  }
  .ad-readout {
    position: relative;
    display: block;
    height: 1.7cqw;
    font-size: 1.15cqw;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--pv-faint);
  }
  .ad-readout > span { position: absolute; inset: 0; transition: opacity 260ms var(--ease-out); }
  .ad-r4 { opacity: 0; }

  .ad-newbtn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6cqw;
    padding: 0.75cqw 0;
    background: var(--pv-accent-soft);
    border: 0.12cqw solid var(--pv-accent);
    border-radius: var(--pv-r-sm);
    color: var(--pv-accent-strong);
    font-size: 1.4cqw;
    font-weight: 700;
  }
  .ad-plus { font-size: 1.7cqw; line-height: 0.8; }

  .ad-nav { display: flex; gap: 0.4cqw; }
  .ad-navi {
    flex: 1;
    text-align: center;
    padding: 0.65cqw 0;
    border: 0.12cqw solid transparent;
    border-radius: var(--pv-r-sm);
    color: var(--pv-dim);
    font-size: 1.2cqw;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .ad-navi.is-on {
    color: var(--pv-accent-strong);
    background: var(--pv-accent-soft);
    border-color: var(--pv-glow);
  }

  .ad-sec, .ad-foot { display: flex; flex-direction: column; gap: 0.25cqw; }
  .ad-foot { margin-top: auto; }
  .ad-head {
    font-size: 1.05cqw;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--pv-faint);
    text-transform: uppercase;
    margin-bottom: 0.4cqw;
  }
  .ad-view, .ad-prof {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.48cqw 0.8cqw;
    border: 0.12cqw solid transparent;
    border-radius: var(--pv-r-sm);
    color: var(--pv-dim);
    font-size: 1.3cqw;
    font-weight: 500;
  }
  .ad-vl { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ad-view.is-on {
    border-color: var(--pv-glow);
    background: var(--pv-accent-soft);
    color: var(--pv-text);
    font-weight: 700;
  }
  .ad-dot { width: 1cqw; height: 1cqw; border-radius: 50%; flex-shrink: 0; }
  .ad-badge {
    flex-shrink: 0;
    min-width: 1.7cqw;
    padding: 0 0.5cqw;
    border-radius: 1cqw;
    background: var(--pv-accent-soft);
    color: var(--pv-accent-strong);
    font-size: 1.05cqw;
    font-weight: 700;
    text-align: center;
    line-height: 1.7;
  }
  /* wartende Session: Marker erst im Frage-Schritt */
  .ad-view--wait { transition: box-shadow 260ms var(--ease-out), background 260ms var(--ease-out); }
  .ad-view--wait .ad-badge { opacity: 0; transition: opacity 240ms var(--ease-out); }

  /* ---------- Hauptbereich ---------- */
  .ad-main { display: flex; flex-direction: column; min-width: 0; min-height: 0; }

  .ad-tabs {
    display: flex;
    align-items: flex-end;
    gap: 0.3cqw;
    padding: 0.7cqw 1cqw 0;
    height: 4.1cqw;
    border-bottom: 0.12cqw solid var(--pv-border);
  }
  .ad-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    height: 3.4cqw;
    padding: 0 1cqw;
    border-radius: var(--pv-r-sm) var(--pv-r-sm) 0 0;
    color: var(--pv-dim);
    font-size: 1.25cqw;
    font-weight: 600;
    white-space: nowrap;
  }
  .ad-tab.is-on { background: var(--pv-raised); color: var(--pv-text); }
  .ad-tabind {
    position: absolute;
    top: 0;
    left: 1cqw;
    right: 1cqw;
    height: 0.28cqw;
    border-radius: 0.2cqw;
    background: var(--c);
  }

  .ad-grid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1.1cqw;
    padding: 1.1cqw 1.2cqw 1.2cqw;
  }

  .ad-pane {
    position: relative;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--pv-panel);
    border: 0.12cqw solid var(--pv-border);
    border-radius: var(--pv-r-md);
    box-shadow: 0 0.1cqw 0 rgb(255 255 255 / 0.02) inset, 0 1.2cqw 2.8cqw rgb(0 0 0 / 0.4);
    overflow: hidden;
    transition:
      opacity 320ms var(--ease-out),
      transform 320ms var(--ease-out),
      border-color 320ms var(--ease-out),
      box-shadow 320ms var(--ease-out);
  }

  .ad-ph {
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    padding: 0.7cqw 0.9cqw;
    border-bottom: 0.12cqw solid var(--pv-border);
    background: var(--pv-raised);
  }
  .ad-pagent { font-size: 1.3cqw; font-weight: 700; color: var(--pv-text); white-space: nowrap; }
  .ad-pcwd {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 1.05cqw;
    color: var(--pv-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ad-status {
    position: relative;
    flex-shrink: 0;
    width: 9.2cqw;
    height: 2.1cqw;
    font-size: 1.05cqw;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .ad-status > span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1.2cqw;
    background: rgb(255 255 255 / 0.05);
    color: var(--pv-dim);
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
    white-space: nowrap;
  }
  .ad-status > .ad-s0 { opacity: 1; }

  .ad-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.22cqw;
    padding: 0.8cqw 0.9cqw;
    font-family: var(--font-mono);
    font-size: 1.32cqw;
    line-height: 1.45;
  }
  .ad-line { white-space: nowrap; overflow: hidden; color: var(--pv-dim); }
  .ad-line.is-shell { color: var(--pv-faint); }
  .ad-line.is-cmd { color: var(--pv-text); font-weight: 600; }
  .ad-line.is-tool { color: var(--pv-dim); }
  .ad-line.is-add { color: #7fc9a0; }
  .ad-line.is-del { color: #f0594f; }
  .ad-line.is-ok { color: var(--pv-accent-strong); }
  .ad-line.is-dim { color: var(--pv-faint); }
  /* Nachlaufende Ausgabe: Endzustand steht im Schritt-Selektor, nur das Von animiert */
  .ad-line[data-at] {
    opacity: 0;
    transform: translateY(0.5cqw);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .ad-cur {
    display: inline-block;
    width: 0.72cqw;
    height: 1.42cqw;
    margin-left: 0.4cqw;
    vertical-align: -0.2cqw;
    background: currentColor;
    visibility: hidden;
  }

  /* ---------- Zwischenfrage (QuestionDialog.tsx) ---------- */
  /* Overlay beginnt unter dem Pane-Kopf, damit sichtbar bleibt, welche Session fragt */
  .ad-qov {
    position: absolute;
    inset: 3.6cqw 0 0 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1cqw;
    background: rgba(6, 8, 11, 0.62);
    opacity: 0;
    transition: opacity 180ms var(--ease-out);
  }
  .ad-dialog {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.55cqw;
    padding: 0.9cqw 1cqw 1cqw;
    background: var(--pv-raised);
    border: 0.12cqw solid var(--pv-border-strong);
    border-radius: var(--pv-r-md);
    box-shadow: 0 1.8cqw 4.4cqw rgb(0 0 0 / 0.5);
    opacity: 0;
    transform: scale(0.94) translateY(0.8cqw);
    /* Basis ist der Austritt: kurz, ohne nachlaufendes Transform. */
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .ad-dhead { display: flex; align-items: baseline; justify-content: space-between; }
  .ad-dtitle {
    font-family: var(--font-display);
    font-size: 1.5cqw;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .ad-dx { color: var(--pv-faint); font-size: 1.6cqw; line-height: 1; }
  .ad-qtext { font-size: 1.42cqw; line-height: 1.35; color: var(--pv-text); }
  .ad-qopts { display: flex; flex-direction: column; gap: 0.2cqw; }
  .ad-qrow {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.5cqw 0.7cqw;
    border: 0.12cqw solid transparent;
    border-radius: var(--pv-r-sm);
    color: var(--pv-dim);
    font-size: 1.32cqw;
    font-weight: 500;
    transition:
      background 140ms ease-out,
      border-color 140ms ease-out,
      color 140ms ease-out,
      transform 140ms var(--ease-out);
  }
  .ad-qi {
    flex-shrink: 0;
    width: 1.9cqw;
    height: 1.9cqw;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0.12cqw solid var(--pv-border-strong);
    border-radius: 0.5cqw;
    font-size: 1.2cqw;
    font-weight: 700;
    color: var(--pv-faint);
    font-style: normal;
  }
  .ad-tap {
    position: absolute;
    right: 1.2cqw;
    top: 50%;
    width: 2.2cqw;
    height: 2.2cqw;
    margin-top: -1.1cqw;
    border-radius: 50%;
    border: 0.2cqw solid var(--pv-accent);
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out);
  }
  .ad-dlabel {
    margin-top: 0.2cqw;
    font-size: 1cqw;
    font-weight: 700;
