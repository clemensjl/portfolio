---
// Vorschau KernMind: selbst gehostetes zweites Gehirn, Karten im Masonry-Grid plus Chat mit Beleg.
// Schritt 0: Bestand. Das Grid zeigt gemischte Karten (Zitat, Farbe, Link mit Vorschauflaeche,
//            Notiz-Checkliste, Bildkarte, Mass-Notiz), darueber Kopfzeile und Omnibar.
// Schritt 1: Sammeln. Eine ueber die Erweiterung gespeicherte Link-Karte faellt oben in die
//            linke Spalte, das Grid rueckt nach, der Hinweis "Saved to your Mind!" erscheint.
// Schritt 2: Fragen. Das Chat-Fenster "Ask your Mind" faehrt auf, die Frage nach dem Nischenmass
//            steht darin, alle Karten ohne Bezug dimmen ab.
// Schritt 3: Antwort mit Beleg. Die Antwort steht im Chat, ein Quellen-Chip verbindet sich per
//            Linie mit der Notiz "Alcove measurements", die einen Akzentring bekommt.
//
// Produkt-UI ist einsprachig Englisch, daher bleiben die Oberflaechentexte englisch (Vertrag).
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const T = {
  de: {
    aria:
      'Vorschau von KernMind: gemischte Karten im Masonry-Grid, eine Frage an den eigenen Bestand und eine Antwort, die auf die Quellkarte verweist.',
  },
  en: {
    aria:
      'Preview of KernMind: mixed cards in a masonry grid, a question asked against your own collection and an answer that points back to the source card.',
  },
}[lang];

// Die Verbindungslinie wird ueber eine Maske gezeichnet. Jede Instanz auf einer Seite
// braucht dafuer eine eigene id.
const linkPath = 'M952 800 C 1024 790, 1058 660, 1068 512';
const linkMaskId = `km-link-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="pv pv-kernmind" data-preview data-step="0" role="img" aria-label={T.aria}>
  <div class="km">
    <!-- Kopfzeile -->
    <div class="km-head">
      <div class="km-brand">
        <span class="km-mark">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 4.2c-2.1 0-3.5 1.2-3.8 2.8-1.6.3-2.6 1.5-2.6 3 0 1 .4 1.8 1.1 2.4-.5.5-.8 1.2-.8 2 0 1.8 1.5 3.2 3.4 3.2.9 0 1.7-.3 2.3-.9"
            ></path>
            <path
              d="M12 4.2c2.1 0 3.5 1.2 3.8 2.8 1.6.3 2.6 1.5 2.6 3 0 1-.4 1.8-1.1 2.4.5.5.8 1.2.8 2 0 1.8-1.5 3.2-3.4 3.2-.9 0-1.7-.3-2.3-.9"
            ></path>
            <path d="M12 4.6v14.4"></path>
          </svg>
        </span>
        <span class="km-brand-text">
          <span class="km-word">KernMind</span>
          <span class="km-sub">byok • local-first</span>
        </span>
      </div>

      <div class="km-nav">
        <span class="km-nav-item is-on"><i class="km-gl km-gl-brain"></i>Mind</span>
        <span class="km-nav-item"><i class="km-gl km-gl-layers"></i>Spaces</span>
        <span class="km-nav-item"><i class="km-gl km-gl-compass"></i>Serendipity</span>
        <span class="km-nav-item"><i class="km-gl km-gl-gear"></i>Settings</span>
      </div>

      <div class="km-acts">
        <span class="km-ask"><i class="km-gl km-gl-spark"></i>Ask Mind</span>
        <span class="km-capture"><i class="km-gl km-gl-plus"></i>Capture</span>
      </div>
    </div>

    <!-- Omnibar -->
    <div class="km-omni">
      <span class="km-omni-ic">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6"></circle><path d="M15 15l4.5 4.5"></path></svg>
      </span>
      <span class="km-omni-ph">Search your mind... (keywords, #tags, colors, URLs)</span>
      <span class="km-omni-kbd">⌘K</span>
    </div>

    <!-- Masonry-Grid -->
    <div class="km-grid">
      <div class="km-col km-col-a">
        <div class="km-new">
          <div class="km-card km-card-link">
            <div class="km-shot km-shot-a"></div>
            <div class="km-pad">
              <div class="km-meta"><span class="km-fav"></span>atelier.blog</div>
              <div class="km-title">A narrow sink that still fits a pot</div>
              <div class="km-tags"><span class="km-tag">#kitchen</span><span class="km-tag">#shopping</span></div>
            </div>
          </div>
        </div>

        <div class="km-stack">
          <div class="km-card km-card-quote">
            <div class="km-row">
              <span class="km-qmark">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17v-4.2C4 8.6 6 6.3 9.6 5.9v2.6C7.6 8.9 6.5 10.2 6.5 12H10v5Zm10.4 0v-4.2c0-4.2 2-6.5 5.6-6.9v2.6c-2 .4-3.1 1.7-3.1 3.5h3.5v5Z"></path></svg>
              </span>
              <span class="km-dom">field notes</span>
            </div>
            <div class="km-quote">A room is finished when nothing in it asks for attention.</div>
            <div class="km-tags km-tags-top"><span class="km-tag">#interior</span><span class="km-tag">#notes</span></div>
          </div>

          <div class="km-card km-card-color">
            <div class="km-swatch"><span class="km-hex">#E07A5F</span></div>
            <div class="km-pad">
              <div class="km-row">
                <span>
                  <span class="km-title">Warm Terracotta</span>
                  <span class="km-rgb">rgb(224, 122, 95)</span>
                </span>
              </div>
              <div class="km-chips">
                <span class="km-dot" style="background:#E07A5F"></span>
                <span class="km-dot" style="background:#C9613F"></span>
                <span class="km-dot" style="background:#EFB48C"></span>
                <span class="km-dot" style="background:#81B29A"></span>
                <span class="km-dot" style="background:#3D405B"></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="km-col km-col-b">
        <div class="km-card km-card-article">
          <div class="km-shot km-shot-b"><span class="km-badge">6 min read</span></div>
          <div class="km-prog"><span></span></div>
          <div class="km-pad">
            <div class="km-meta"><span class="km-fav"></span>longform.press</div>
            <div class="km-title">Small kitchens that still cook well</div>
            <div class="km-body">Counter depth, one good light, and a place for everything you use daily.</div>
          </div>
        </div>

        <div class="km-card km-card-note">
          <div class="km-row"><span class="km-note-ic"></span><span class="km-title">Kitchen list</span></div>
          <div class="km-todo is-done"><span class="km-box"></span>Measure the alcove</div>
          <div class="km-todo"><span class="km-box"></span>Ask about tile lead time</div>
          <div class="km-todo"><span class="km-box"></span>Decide on the sink</div>
        </div>
      </div>

      <div class="km-col km-col-c">
        <div class="km-card km-card-src">
          <div class="km-row"><span class="km-note-ic"></span><span class="km-title">Alcove measurements</span></div>
          <div class="km-body">Alcove 182 cm wide, 64 cm deep. Socket sits 40 cm above the counter.</div>
          <div class="km-tags km-tags-top"><span class="km-tag">#kitchen</span><span class="km-tag">#measure</span></div>
          <span class="km-ring"></span>
        </div>

        <div class="km-card km-card-image">
          <div class="km-shot km-shot-c">
            <span class="km-badge km-badge-l">OCR Extracted</span>
            <span class="km-palette">
              <span class="km-dot km-dot-s" style="background:#E07A5F"></span>
              <span class="km-dot km-dot-s" style="background:#D9A187"></span>
              <span class="km-dot km-dot-s" style="background:#8C5A44"></span>
              <span class="km-dot km-dot-s" style="background:#F2EDE4"></span>
            </span>
          </div>
          <div class="km-pad">
            <div class="km-title">Glazed clay tile, sample 3</div>
            <div class="km-tags"><span class="km-tag">#tiles</span><span class="km-tag">#terracotta</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Hinweis der Erweiterung -->
    <div class="km-toast"><span class="km-check"></span>Saved to your Mind!</div>

    <!-- Verbindungslinie zwischen Quellen-Chip und Quellkarte -->
    <svg class="km-link" viewBox="0 0 1600 1000" aria-hidden="true">
      <defs>
        <mask id={linkMaskId} maskUnits="userSpaceOnUse" x="0" y="0" width="1600" height="1000">
          <path d={linkPath} pathLength="1" class="km-link-mask"></path>
        </mask>
      </defs>
      <g mask={`url(#${linkMaskId})`}>
        <path d={linkPath} class="km-link-path"></path>
        <circle cx="1068" cy="512" r="7" class="km-link-end"></circle>
      </g>
    </svg>

    <!-- Chat -->
    <div class="km-ask-panel">
      <div class="km-ask-head">
        <span class="km-ask-ic"><i class="km-gl km-gl-spark"></i></span>
        <span>
          <span class="km-ask-t">Ask your Mind</span>
          <span class="km-ask-s">Conversational recall across your second brain</span>
        </span>
      </div>

      <div class="km-stream">
        <div class="km-msg km-msg-user">
          <span class="km-av km-av-user"></span>
          <span class="km-bubble">How wide is the alcove in the kitchen?</span>
        </div>

        <div class="km-answer-wrap">
          <div class="km-msg km-msg-skel">
            <span class="km-av km-av-bot"><i class="km-gl km-gl-spark"></i></span>
            <span class="km-bubble km-bubble-bot">
              <span class="km-loading"><span class="km-spin"></span>Synthesizing your memories...</span>
              <span class="km-bar" style="width:94%"></span>
              <span class="km-bar" style="width:78%"></span>
              <span class="km-bar" style="width:88%"></span>
              <span class="km-bar" style="width:62%"></span>
              <span class="km-bar" style="width:40%"></span>
            </span>
          </div>
          <div class="km-msg km-msg-bot">
            <span class="km-av km-av-bot"><i class="km-gl km-gl-spark"></i></span>
            <span class="km-bubble km-bubble-bot">
              <span class="km-answer">The alcove is 182 cm wide and 64 cm deep. The socket sits 40 cm above the counter.</span>
              <span class="km-cite">
                <span class="km-cite-l">Cited Memories:</span>
                <span class="km-cite-chip"><span class="km-bm"></span>Alcove measurements<span class="km-arr"></span></span>
              </span>
            </span>
          </div>
        </div>
      </div>

      <div class="km-ask-input">
        <span class="km-field">Ask anything about your saved memories...<span class="km-caret"></span></span>
        <span class="km-send"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .pv-kernmind {
    --bg: #fdfbf7;
    --card: #fff;
    --fg: #1c1917;
    --sec: #f2ede4;
    --mut: #e7e0d3;
    --mfg: #78716c;
    --bd: #eadbce;
    --ac: #e07a5f;
    --r: 1.7cqw;
    --sans: var(--font-sans, system-ui, sans-serif);
    --serif: ui-serif, Georgia, 'Times New Roman', serif;
    --mono: var(--font-mono, ui-monospace, Consolas, monospace);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--sans);
    box-shadow:
      0 40px 80px -40px rgb(0 0 0 / 0.7),
      inset 0 0 0 1px rgb(28 25 23 / 0.06);
  }
  .km {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .km-gl {
    display: inline-block;
    width: 1.5cqw;
    height: 1.5cqw;
    border-radius: 0.3cqw;
    background: currentColor;
    opacity: 0.85;
    flex: none;
  }
  .km-gl-brain { border-radius: 50%; }
  .km-gl-layers { clip-path: polygon(50% 0, 100% 30%, 50% 60%, 0 30%); }
  .km-gl-compass { border-radius: 50%; clip-path: polygon(50% 0, 72% 72%, 0 50%, 72% 28%); }
  .km-gl-gear { border-radius: 50%; clip-path: polygon(50% 0, 65% 14%, 86% 14%, 86% 35%, 100% 50%, 86% 65%, 86% 86%, 65% 86%, 50% 100%, 35% 86%, 14% 86%, 14% 65%, 0 50%, 14% 35%, 14% 14%, 35% 14%); }
  .km-gl-spark { clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); }
  .km-gl-plus { clip-path: polygon(42% 0, 58% 0, 58% 42%, 100% 42%, 100% 58%, 58% 58%, 58% 100%, 42% 100%, 42% 58%, 0 58%, 0 42%, 42% 42%); }

  /* Kopfzeile */
  .km-head {
    position: absolute;
    inset: 0 0 auto 0;
    height: 7.8cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6cqw;
    padding: 0 3.2cqw;
    border-bottom: 0.14cqw solid rgb(234 219 206 / 0.7);
    background: rgb(253 251 247 / 0.9);
    z-index: 4;
  }
  .km-brand { display: flex; align-items: center; gap: 1cqw; flex: none; }
  .km-mark {
    width: 4.2cqw;
    height: 4.2cqw;
    border-radius: 1.2cqw;
    background: linear-gradient(140deg, #e88f77, var(--ac));
    display: grid;
    place-items: center;
  }
  .km-mark svg { width: 3cqw; height: 3cqw; fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; }
  .km-brand-text { display: grid; gap: 0.25cqw; }
  .km-word { font-size: 2.3cqw; font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .km-sub { font-family: var(--mono); font-size: 1.35cqw; color: var(--mfg); line-height: 1; }

  .km-nav {
    display: flex;
    align-items: center;
    gap: 0.3cqw;
    padding: 0.4cqw;
    border-radius: 999px;
    background: rgb(242 237 228 / 0.6);
    border: 0.12cqw solid rgb(234 219 206 / 0.6);
  }
  .km-nav-item {
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    padding: 0.7cqw 1.4cqw;
    border-radius: 999px;
    font-size: 1.55cqw;
    font-weight: 500;
    color: var(--mfg);
    white-space: nowrap;
  }
  .km-nav-item.is-on {
    background: var(--card);
    color: var(--fg);
    box-shadow: 0 0.2cqw 0.5cqw rgb(28 25 23 / 0.06);
  }

  .km-acts { display: flex; align-items: center; gap: 0.8cqw; flex: none; }
  .km-ask,
  .km-capture {
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    padding: 0.8cqw 1.5cqw;
    border-radius: 999px;
    font-size: 1.55cqw;
    font-weight: 600;
    white-space: nowrap;
  }
  .km-ask {
    background: rgb(224 122 95 / 0.12);
    color: var(--ac);
    transition: transform 320ms var(--ease-out, ease), box-shadow 320ms var(--ease-out, ease);
  }
  .km-capture { background: var(--fg); color: #fff; }

  /* Omnibar */
  .km-omni {
    position: absolute;
    top: 11.2cqw;
    left: 50%;
    width: 60cqw;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.2cqw;
    height: 5.4cqw;
    padding: 0 1.6cqw;
    border-radius: 999px;
    background: var(--card);
    border: 0.14cqw solid var(--bd);
    box-shadow: 0 0.6cqw 1.6cqw -0.8cqw rgb(28 25 23 / 0.12);
    z-index: 3;
  }
  .km-omni-ic { width: 2.1cqw; height: 2.1cqw; flex: none; }
  .km-omni-ic svg { width: 100%; height: 100%; fill: none; stroke: var(--mfg); stroke-width: 2; stroke-linecap: round; }
  .km-omni-ph { flex: 1; font-size: 1.7cqw; color: rgb(120 113 108 / 0.75); overflow: hidden; white-space: nowrap; }
  .km-omni-kbd {
    font-family: var(--mono);
    font-size: 1.35cqw;
    color: var(--mfg);
    background: rgb(242 237 228 / 0.9);
    padding: 0.3cqw 0.8cqw;
    border-radius: 0.6cqw;
    flex: none;
  }

  /* Grid */
  .km-grid {
    position: absolute;
    top: 19.4cqw;
    left: 3.2cqw;
    right: 3.2cqw;
    bottom: 0;
    display: flex;
    gap: 2.2cqw;
    align-items: flex-start;
  }
  .km-col { flex: 1 1 0; min-width: 0; position: relative; }
  .km-stack { display: grid; gap: 2.2cqw; }
  .km-col-b,
  .km-col-c { display: grid; gap: 2.2cqw; align-content: start; }

  .km-card {
    position: relative;
    background: var(--card);
    border: 0.14cqw solid rgb(234 219 206 / 0.8);
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: 0 0.5cqw 1.4cqw -0.9cqw rgb(28 25 23 / 0.16);
    /* filter bleibt bewusst aussen vor: saturate() auf sechs Karten zu animieren
       kostet mehr, als der Uebergang zeigt. Der Endzustand bleibt. */
    transition:
      opacity 360ms var(--ease-out, ease),
      transform 420ms var(--ease-out, ease);
  }
  .km-pad { padding: 1.5cqw; display: grid; gap: 0.8cqw; }
  .km-card-quote,
  .km-card-note,
  .km-card-src { padding: 1.7cqw; display: grid; gap: 1cqw; }

  .km-row { display: flex; align-items: center; gap: 0.7cqw; justify-content: space-between; }
  .km-card-note .km-row,
  .km-card-src .km-row { justify-content: flex-start; }
  .km-title { display: block; font-size: 1.8cqw; font-weight: 600; letter-spacing: -0.01em; }
  .km-body { font-size: 1.62cqw; color: #57534e; line-height: 1.45; }
  .km-meta { display: flex; align-items: center; gap: 0.6cqw; font-size: 1.4cqw; color: var(--mfg); }
  .km-fav { width: 1.3cqw; height: 1.3cqw; border-radius: 0.3cqw; background: var(--mut); flex: none; }
  .km-dom { font-size: 1.35cqw; color: var(--mfg); }
  .km-rgb { display: block; font-family: var(--mono); font-size: 1.3cqw; color: var(--mfg); margin-top: 0.25cqw; }

  .km-tags { display: flex; flex-wrap: wrap; gap: 0.6cqw; }
  .km-tags-top { padding-top: 0.8cqw; border-top: 0.12cqw solid rgb(234 219 206 / 0.6); }
  .km-tag {
    font-size: 1.3cqw;
    font-weight: 500;
    color: #44403c;
    background: var(--sec);
    padding: 0.25cqw 0.8cqw;
    border-radius: 999px;
  }

  .km-qmark { width: 2cqw; height: 2cqw; }
  .km-qmark svg { width: 100%; height: 100%; fill: rgb(224 122 95 / 0.85); }
  .km-quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: 2.35cqw;
    line-height: 1.35;
  }

  .km-swatch {
    height: 8.4cqw;
    background: var(--ac);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1cqw;
  }
  .km-hex {
    font-family: var(--mono);
    font-size: 1.3cqw;
    color: #fff;
    background: rgb(0 0 0 / 0.35);
    padding: 0.25cqw 0.8cqw;
    border-radius: 999px;
  }
  .km-chips { display: flex; gap: 0.6cqw; }
  .km-dot { width: 2cqw; height: 2cqw; border-radius: 999px; display: block; }
  .km-dot-s { width: 1.2cqw; height: 1.2cqw; border: 0.1cqw solid rgb(255 255 255 / 0.4); }

  .km-shot { position: relative; height: 9.6cqw; }
  .km-shot-a { height: 7.4cqw; background: linear-gradient(135deg, #f6ece4 0%, #e9cdbb 55%, #d9a187 100%); }
  .km-shot-b { background: linear-gradient(140deg, #f4e7dc 0%, #e0a98c 60%, #b8664a 100%); }
  .km-shot-c { height: 11.5cqw; background: linear-gradient(160deg, #e07a5f 0%, #c9613f 45%, #8c5a44 100%); }
  .km-badge {
    position: absolute;
    right: 0.9cqw;
    bottom: 0.9cqw;
    font-size: 1.25cqw;
    font-weight: 500;
    color: #fff;
    background: rgb(0 0 0 / 0.45);
    padding: 0.25cqw 0.8cqw;
    border-radius: 999px;
  }
  .km-badge-l { right: auto; bottom: auto; left: 0.9cqw; top: 0.9cqw; }
  .km-palette {
    position: absolute;
    left: 0.9cqw;
    bottom: 0.9cqw;
    display: flex;
    gap: 0.4cqw;
    padding: 0.4cqw;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.35);
  }
  .km-prog { height: 0.5cqw; background: var(--sec); }
  .km-prog span { display: block; width: 45%; height: 100%; background: var(--ac); }

  .km-note-ic {
    width: 1.5cqw;
    height: 1.9cqw;
    background: var(--ac);
    clip-path: polygon(0 0, 66% 0, 100% 26%, 100% 100%, 0 100%);
    flex: none;
  }
  .km-todo { display: flex; align-items: center; gap: 0.8cqw; font-size: 1.62cqw; color: #57534e; }
  .km-box {
    width: 1.5cqw;
    height: 1.5cqw;
    border-radius: 0.35cqw;
    border: 0.18cqw solid var(--mut);
    flex: none;
  }
  .km-todo.is-done { color: rgb(120 113 108 / 0.7); text-decoration: line-through; }
  .km-todo.is-done .km-box { background: var(--ac); border-color: var(--ac); }

  /* Quellkarte: Ring */
  .km-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    border: 0.36cqw solid var(--ac);
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 360ms var(--ease-out, ease),
      transform 360ms var(--ease-out, ease);
    pointer-events: none;
  }

  /* Neue Karte */
  .km-new {
    position: absolute;
