---
/*
  agentfenster — Kontrollraum fuer Klick-Agenten unter Windows.
  Nachgebaut nach der echten Oberflaeche (agentfenster/agentfenster/web/index.html,
  stil/grund.css, js/agent_lauf.js, js/aufnahmen.js, js/aktivitaet_farben.js).
  Die Oberflaeche der echten App ist ausschliesslich englisch, deshalb bleiben
  alle Produkt-Texte englisch; nur das aria-label ist zweisprachig.

  Die vier Schritte:
  0  Kontrollraum in Ruhe: Reiter Agent, links Workspaces und Chat, in der Mitte
     der Livestream des unsichtbaren Agenten-Desktops mit einem einzigen offenen
     Fenster, darunter das eingebettete Terminal, rechts das Activity-Protokoll.
  1  Der Agent arbeitet: der virtuelle Zeiger faehrt auf das Feld "Amount",
     klickt (Ring), der Wert steht im Feld, das Protokoll bekommt die Eintraege
     "Click" und "Type into".
  2  Ehrlichkeit: ein Klick bleibt wirkungslos, an der Stelle bleibt ein roter
     Ring stehen, der Protokolleintrag traegt den Merker "no effect"; der
     korrigierte zweite Klick sitzt und der Fensterzustand aendert sich sichtbar.
  3  Ergebnis: Reiter Recordings, der Lauf als abspielbarer Film mit Zeitleiste,
     Markern pro Aktion, Abspielkopf und der Schrittliste samt Ergebniszeile.
*/
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;

const T = {
  de: {
    aria:
      'Vorschau von agentfenster: ein dunkler Kontrollraum zeigt den Livestream eines unsichtbaren ' +
      'Agenten-Desktops, daneben ein Aktivitaetsprotokoll, in dem ein wirkungsloser Klick als "no effect" ' +
      'markiert wird, und zuletzt die Zeitleiste des aufgezeichneten Laufs.',
  },
  en: {
    aria:
      'Preview of agentfenster: a dark control room showing the live stream of an invisible agent desktop, ' +
      'an activity log that marks a click without effect as "no effect", and finally the timeline of the ' +
      'recorded run.',
  },
}[lang];
---

<div class="pv pv-agentfenster" data-preview data-step="0" role="img" aria-label={T.aria}>
  <div class="af">
    <!-- Kopfzeile: Marke, Fassung, Reiter, Hilfe, Fensterknoepfe -->
    <div class="af-kopf">
      <div class="af-marke">
        <span class="af-marke-punkt"></span>
        <span class="af-marke-name">agentfenster</span>
        <span class="af-mono af-version">0.3.9</span>
      </div>
      <div class="af-reiter">
        <span class="af-tab" data-tab="agent">Agent<i></i></span>
        <span class="af-tab" data-tab="aufnahmen">Recordings<i></i></span>
        <span class="af-tab">Skills<i></i></span>
        <span class="af-tab">Memory<i></i></span>
        <span class="af-tab">Settings<i></i></span>
      </div>
      <span class="af-hilfe">?</span>
      <span class="af-fuellung"></span>
      <div class="af-fk">
        <span class="af-fk-min"></span><span class="af-fk-max"></span><span class="af-fk-zu"></span>
      </div>
    </div>

    <div class="af-raum">
      <!-- ============================================================ Agent -->
      <div class="af-ansicht af-agent">
        <div class="af-ansicht-kopf">
          <p class="af-ansicht-titel">Agent</p>
          <p class="af-ansicht-unter">The agent works on its own desktop. Watch it, step in, or take over.</p>
        </div>

        <div class="af-raster">
          <!-- Linke Spalte: Workspaces und Chat -->
          <div class="af-spalte">
            <div class="af-feld">
              <div class="af-feld-kopf"><p class="af-feld-titel">Workspaces</p><span class="af-plus"></span></div>
              <div class="af-ws af-ws-aktiv"><span class="af-punkt" style="--p:#5c8fc4"></span><span>Invoices</span></div>
              <div class="af-ws"><span class="af-punkt" style="--p:#4fa8a0"></span><span>Reports</span></div>
              <div class="af-ws"><span class="af-punkt" style="--p:#8f7fd0"></span><span>Mailbox</span></div>
            </div>

            <div class="af-feld af-feld-wachsend">
              <div class="af-feld-kopf"><p class="af-feld-titel">Chat</p></div>
              <div class="af-chat-verlauf">
                <p class="af-blase">Enter the invoice and save it</p>
                <p class="af-blase af-blase-agent">Six steps planned. Watching the window after every one of them.</p>
              </div>
              <div class="af-komposition">
                <div class="af-regler">
                  <p class="af-regler-titel">Autonomy</p>
                  <div class="af-segmente">
                    <span class="af-segment">Low</span><span class="af-segment af-an">Medium</span><span class="af-segment">High</span>
                  </div>
                </div>
                <div class="af-regler">
                  <p class="af-regler-titel">Permission</p>
                  <div class="af-segmente">
                    <span class="af-segment af-an">Ask first</span><span class="af-segment">Free</span><span class="af-segment">Dry run</span>
                  </div>
                </div>
                <div class="af-eingabe">
                  <span class="af-ikon af-ikon-buch"></span>
                  <span class="af-platzhalter">Describe a task…</span>
                  <span class="af-ikon af-ikon-mikro"></span>
                  <span class="af-senden"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Mitte: Buehne und Terminal -->
          <div class="af-mitte">
            <div class="af-buehne">
              <div class="af-zielfenster">
                <div class="af-zf-leiste">
                  <span class="af-zf-titel">Invoice entry</span>
                  <span class="af-zf-knoepfe"><i class="af-zf-min"></i><i class="af-zf-max"></i><i class="af-zf-zu"></i></span>
                </div>
                <div class="af-zf-werkzeuge">
                  <span class="af-zf-wz">New</span><span class="af-zf-wz">Open</span><span class="af-zf-wz af-zf-wz-aus">Save</span>
                </div>
                <div class="af-zf-koerper">
                  <div class="af-zf-zeile"><span class="af-zf-marke">Number</span><span class="af-zf-feld">INV-2412</span></div>
                  <div class="af-zf-zeile"><span class="af-zf-marke">Date</span><span class="af-zf-feld">2026-09-15</span></div>
                  <div class="af-zf-zeile"><span class="af-zf-marke">Amount</span><span class="af-zf-feld af-zf-ziel"><span class="af-zf-wert">1,240.00</span></span></div>
                </div>
                <div class="af-zf-liste">
                  <div class="af-zf-lz af-zf-lkopf"><span>Number</span><span>Date</span><span>Amount</span></div>
                  <div class="af-zf-lz"><span>INV-2410</span><span>2026-09-02</span><span>880.00</span></div>
                  <div class="af-zf-lz"><span>INV-2411</span><span>2026-09-09</span><span>1,105.00</span></div>
                  <div class="af-zf-lz af-zf-lneu"><span>INV-2412</span><span>2026-09-15</span><span>1,240.00</span></div>
                </div>
                <div class="af-zf-fuss">
                  <span class="af-zf-status">Entry saved</span>
                  <span class="af-zf-knopf">Cancel</span>
                  <span class="af-zf-knopf af-zf-knopf-haupt">Save</span>
                </div>
              </div>

              <div class="af-marke-live"><span class="af-puls"></span><span>Live</span></div>

              <span class="af-geisterring"></span>
              <span class="af-zeiger">
                <span class="af-ring"></span>
                <svg viewBox="0 0 13 19" aria-hidden="true">
                  <path d="M1 1 L1 15.6 L4.9 12 L7.3 17.6 L9.9 16.4 L7.5 11 L12 11 Z"
                        fill="#27b883" stroke="#080808" stroke-width="1.1" stroke-linejoin="round" />
                </svg>
              </span>
            </div>

            <div class="af-feld af-terminal">
              <div class="af-feld-kopf"><p class="af-feld-titel">Terminal</p></div>
              <div class="af-mono af-term-flaeche">
                <p><span class="af-term-pfad">PS C:\work&gt;</span> claude</p>
                <p class="af-term-leise">agentfenster mcp · 13 tools · desktop agent</p>
                <p><span class="af-term-gruen">&gt;</span> desktop_task("Enter the invoice and save it")</p>
                <p class="af-term-leise af-term-lauf">
                  <span class="af-term-var" data-von="0">starting · step 1 of 6</span>
                  <span class="af-term-var" data-von="1">running · step 3 of 6</span>
                  <span class="af-term-var" data-von="2">running · step 5 of 6</span>
                  <span class="af-karet"></span>
                </p>
              </div>
            </div>
          </div>

          <!-- Rechts: Activity -->
          <div class="af-spalte">
            <div class="af-feld af-feld-wachsend">
              <div class="af-feld-kopf">
                <p class="af-feld-titel">Activity</p>
                <span class="af-stop">Stop</span>
              </div>
              <div class="af-verlauf">
                <div class="af-eintrag" data-tat="windows" data-von="0">
                  <span class="af-rail"><span class="af-mono af-zeit">0.0s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten">
                    <span class="af-tat">Windows</span>
                    <span class="af-titel">Open “Invoice entry”</span>
                  </span>
                </div>
                <div class="af-eintrag" data-tat="clicking" data-von="1">
                  <span class="af-rail"><span class="af-mono af-zeit">1.2s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten">
                    <span class="af-tat">Clicking</span>
                    <span class="af-titel">Click “Amount”</span>
                  </span>
                </div>
                <div class="af-eintrag" data-tat="typing" data-von="1">
                  <span class="af-rail"><span class="af-mono af-zeit">1.8s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten">
                    <span class="af-tat">Typing</span>
                    <span class="af-titel">Type into “Amount”</span>
                  </span>
                </div>
                <div class="af-eintrag af-warnt" data-tat="clicking" data-von="2">
                  <span class="af-rail"><span class="af-mono af-zeit">2.6s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten">
                    <span class="af-titel">Click “Save” <span class="af-chip">no effect</span></span>
                    <span class="af-neben">The screen did not change. The agent is not clicking on blindly.</span>
                  </span>
                </div>
                <div class="af-eintrag" data-tat="clicking" data-von="2">
                  <span class="af-rail"><span class="af-mono af-zeit">3.4s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten">
                    <span class="af-tat">Clicking</span>
                    <span class="af-titel">Click “Save”</span>
                  </span>
                </div>
              </div>
              <div class="af-fuss af-fuss-stapel">
                <span class="af-fuss-satz" data-von="0">
                  <span class="af-fuss-wert"><span>Steps</span><b>1</b></span>
                  <span class="af-fuss-wert"><span>Tree tokens</span><b>1,904</b></span>
                  <span class="af-fuss-wert"><span>Elapsed</span><b>0.4s</b></span>
                </span>
                <span class="af-fuss-satz" data-von="1">
                  <span class="af-fuss-wert"><span>Steps</span><b>3</b></span>
                  <span class="af-fuss-wert"><span>Tree tokens</span><b>5,166</b></span>
                  <span class="af-fuss-wert"><span>Elapsed</span><b>1.8s</b></span>
                </span>
                <span class="af-fuss-satz" data-von="2">
                  <span class="af-fuss-wert"><span>Steps</span><b>5</b></span>
                  <span class="af-fuss-wert"><span>Tree tokens</span><b>8,412</b></span>
                  <span class="af-fuss-wert"><span>Elapsed</span><b>3.4s</b></span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ======================================================= Recordings -->
      <div class="af-ansicht af-aufnahmen">
        <div class="af-ansicht-kopf">
          <p class="af-ansicht-titel">Recordings</p>
          <p class="af-ansicht-unter">Every run is kept as a replayable film. Scrub it, step through it, slow it down.</p>
          <span class="af-kopf-knopf">Hand off</span>
        </div>

        <div class="af-raster">
          <div class="af-spalte">
            <div class="af-feld">
              <div class="af-feld-kopf"><p class="af-feld-titel">Runs</p></div>
              <div class="af-lauf af-lauf-aktiv">
                <p class="af-lauf-titel">Enter the invoice and save it</p>
                <p class="af-mono af-lauf-meta">6 steps · 5.8s</p>
              </div>
              <div class="af-lauf">
                <p class="af-lauf-titel">Rename the export folder</p>
                <p class="af-mono af-lauf-meta">4 steps · 3.1s</p>
              </div>
              <div class="af-lauf">
                <p class="af-lauf-titel">Collect the weekly numbers</p>
                <p class="af-mono af-lauf-meta">11 steps · 24.7s</p>
              </div>
            </div>
          </div>

          <div class="af-mitte af-mitte-abspiel">
            <div class="af-buehne af-buehne-abspiel">
              <div class="af-zielfenster af-zielfenster-fertig">
                <div class="af-zf-leiste">
                  <span class="af-zf-titel">Invoice entry</span>
                  <span class="af-zf-knoepfe"><i class="af-zf-min"></i><i class="af-zf-max"></i><i class="af-zf-zu"></i></span>
                </div>
                <div class="af-zf-werkzeuge">
                  <span class="af-zf-wz">New</span><span class="af-zf-wz">Open</span><span class="af-zf-wz af-zf-wz-aus">Save</span>
                </div>
                <div class="af-zf-koerper">
                  <div class="af-zf-zeile"><span class="af-zf-marke">Number</span><span class="af-zf-feld">INV-2412</span></div>
                  <div class="af-zf-zeile"><span class="af-zf-marke">Date</span><span class="af-zf-feld">2026-09-15</span></div>
                  <div class="af-zf-zeile"><span class="af-zf-marke">Amount</span><span class="af-zf-feld"><span class="af-zf-wert">1,240.00</span></span></div>
                </div>
                <div class="af-zf-liste">
                  <div class="af-zf-lz af-zf-lkopf"><span>Number</span><span>Date</span><span>Amount</span></div>
                  <div class="af-zf-lz"><span>INV-2410</span><span>2026-09-02</span><span>880.00</span></div>
                  <div class="af-zf-lz"><span>INV-2411</span><span>2026-09-09</span><span>1,105.00</span></div>
                  <div class="af-zf-lz af-zf-lneu"><span>INV-2412</span><span>2026-09-15</span><span>1,240.00</span></div>
                </div>
                <div class="af-zf-fuss">
                  <span class="af-zf-status">Entry saved</span>
                  <span class="af-zf-knopf">Cancel</span>
                  <span class="af-zf-knopf af-zf-knopf-haupt">Save</span>
                </div>
              </div>
              <span class="af-spurpunkt" style="--x:39.1%; --y:35%"></span>
              <span class="af-spurpunkt af-spurpunkt-warn" style="--x:24.8%; --y:16.8%"></span>
              <span class="af-spurpunkt" style="--x:72.5%; --y:84.3%"></span>
            </div>

            <div class="af-abspieler">
              <div class="af-zeitzeile">
                <span class="af-mono af-zeitmarke">2.6s</span>
                <span class="af-zeitleiste">
                  <span class="af-spur-grund"><span class="af-fuellung-zeit"></span></span>
                  <span class="af-marken">
                    <i style="--x:4%"></i><i style="--x:21%"></i><i style="--x:33%"></i>
                    <i class="af-marke-warn" style="--x:45%"></i><i style="--x:64%"></i><i style="--x:88%"></i>
                  </span>
                  <span class="af-kopf-abspiel"></span>
                </span>
                <span class="af-mono af-zeitmarke">5.8s</span>
              </div>
              <div class="af-transport">
                <span class="af-tknopf af-tknopf-zurueck"></span>
                <span class="af-tknopf af-tknopf-play"></span>
                <span class="af-tknopf af-tknopf-vor"></span>
                <span class="af-segmente af-tempo">
                  <span class="af-segment af-an">1×</span><span class="af-segment">2×</span><span class="af-segment">4×</span><span class="af-segment">8×</span>
                </span>
              </div>
            </div>
          </div>

          <div class="af-spalte">
            <div class="af-feld af-feld-wachsend">
              <div class="af-feld-kopf"><p class="af-feld-titel">Steps</p></div>
              <div class="af-verlauf">
                <div class="af-eintrag af-schritt" data-tat="windows">
                  <span class="af-rail"><span class="af-mono af-zeit">0.0s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten"><span class="af-titel">1. Open “Invoice entry”</span></span>
                </div>
                <div class="af-eintrag af-schritt" data-tat="clicking">
                  <span class="af-rail"><span class="af-mono af-zeit">1.2s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten"><span class="af-titel">2. Click “Amount”</span></span>
                </div>
                <div class="af-eintrag af-schritt" data-tat="typing">
                  <span class="af-rail"><span class="af-mono af-zeit">1.8s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten"><span class="af-titel">3. Type into “Amount”</span></span>
                </div>
                <div class="af-eintrag af-schritt af-warnt" data-tat="clicking">
                  <span class="af-rail"><span class="af-mono af-zeit">2.6s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten">
                    <span class="af-titel">4. Click “Save” <span class="af-chip">no effect</span></span>
                    <span class="af-neben">The screen did not change after this step.</span>
                  </span>
                </div>
                <div class="af-eintrag af-schritt" data-tat="clicking">
                  <span class="af-rail"><span class="af-mono af-zeit">3.4s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten"><span class="af-titel">5. Click “Save”</span></span>
                </div>
                <div class="af-eintrag af-schritt">
                  <span class="af-rail"><span class="af-mono af-zeit">5.8s</span><span class="af-schiene"></span></span>
                  <span class="af-kasten"><span class="af-titel">6. Finish</span></span>
                </div>
              </div>
              <div class="af-fuss">
                <span class="af-fuss-wert"><span>Result</span><b>success</b></span>
                <span class="af-fuss-wert"><span>Steps</span><b>6</b></span>
                <span class="af-fuss-wert"><span>Tokens</span><b>8,412</b></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Farben, Radien, Schriften und Abstaende stammen aus
     agentfenster/agentfenster/web/stil/grund.css. */
  .pv-agentfenster {
    --af-grund: #080808;
    --af-erhoht: #0e0e10;
    --af-hoeher: #141417;
    --af-linie: #1c1c1f;
    --af-linie-stark: #2a2a2e;
    --af-akzent: #27b883;
    --af-akzent-dunkel: #1c7957;
    --af-akzent-flaeche: #0c1d17;
    --af-akzent-rand: #14402f;
    --af-text: #e6e6e6;
    --af-leise: #8a8a8a;
    --af-warnung: #d9705c;
    --af-warnung-flaeche: #1c100d;
    --af-warnung-rand: #4b241c;
    --tat-klick: #5c8fc4;
    --tat-tippen: #4fa8a0;
    --tat-fenster: #b0a36e;
    --af-r-karte: 1.1cqw;
    --af-r-knopf: 0.7cqw;
    --af-schrift: 'Segoe UI Variable Display', 'Segoe UI', system-ui, -apple-system, sans-serif;
    --af-mono: 'Cascadia Mono', 'Consolas', ui-monospace, monospace;
    background: var(--af-grund);
  }

  .af {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 4cqw 1fr;
    background: var(--af-grund);
    color: var(--af-text);
    font-family: var(--af-schrift);
    font-size: 1.4cqw;
    line-height: 1.32;
  }
  .af p { margin: 0; }
  .af-mono { font-family: var(--af-mono); }

  /* ------------------------------------------------------------- Kopfzeile */
  .af-kopf {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 0 1.2cqw;
    border-bottom: 1px solid var(--af-linie);
    background: var(--af-erhoht);
  }
  .af-marke { display: flex; align-items: baseline; gap: 0.55cqw; }
  .af-marke-punkt {
    width: 0.9cqw; height: 0.9cqw; border-radius: 999px; align-self: center;
    background: var(--af-akzent); box-shadow: 0 0 0 0.3cqw rgb(39 184 131 / 0.14);
  }
  .af-marke-name { font-size: 1.5cqw; font-weight: 600; }
  .af-version { font-size: 1cqw; color: var(--af-leise); }

  .af-reiter { display: flex; align-items: center; gap: 1.3cqw; }
  .af-tab {
    position: relative;
    font-size: 1.4cqw;
    color: var(--af-leise);
    transition: color 300ms var(--ease-out);
    white-space: nowrap;
  }
  .af-tab i {
    position: absolute; left: -0.1cqw; right: -0.1cqw; bottom: -0.75cqw;
    height: 0.2cqw; border-radius: 999px; background: var(--af-akzent);
    opacity: 0; transition: opacity 300ms var(--ease-out);
  }
  .pv-agentfenster[data-step='0'] .af-tab[data-tab='agent'],
  .pv-agentfenster[data-step='1'] .af-tab[data-tab='agent'],
  .pv-agentfenster[data-step='2'] .af-tab[data-tab='agent'],
  .pv-agentfenster[data-step='3'] .af-tab[data-tab='aufnahmen'] { color: var(--af-text); }
  .pv-agentfenster[data-step='0'] .af-tab[data-tab='agent'] i,
  .pv-agentfenster[data-step='1'] .af-tab[data-tab='agent'] i,
  .pv-agentfenster[data-step='2'] .af-tab[data-tab='agent'] i,
  .pv-agentfenster[data-step='3'] .af-tab[data-tab='aufnahmen'] i { opacity: 1; }

  .af-hilfe {
    width: 1.8cqw; height: 1.8cqw; border-radius: 999px; flex: none;
    border: 1px solid var(--af-linie-stark); color: var(--af-leise);
    font-size: 1.1cqw; display: grid; place-items: center; line-height: 1;
  }
  .af-fuellung { flex: 1; }
  .af-fk { display: flex; align-items: center; gap: 1.4cqw; }
  .af-fk span { position: relative; width: 1.1cqw; height: 1.1cqw; }
  .af-fk-min::before {
    content: ''; position: absolute; left: 0; right: 0; top: 50%;
    height: 1px; background: var(--af-leise);
  }
  .af-fk-max::before {
    content: ''; position: absolute; inset: 0.1cqw;
    border: 1px solid var(--af-leise);
  }
  .af-fk-zu::before, .af-fk-zu::after {
    content: ''; position: absolute; left: 0; right: 0; top: 50%;
    height: 1px; background: var(--af-leise);
  }
  .af-fk-zu::before { transform: rotate(45deg); }
  .af-fk-zu::after { transform: rotate(-45deg); }

  /* ------------------------------------------------------- Ansichtswechsel */
  .af-raum { display: grid; padding: 1.2cqw; min-height: 0; }
  .af-ansicht {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1cqw;
    min-height: 0;
    transition: opacity 340ms var(--ease-out), transform 340ms var(--ease-out);
  }
  .af-agent { opacity: 1; transform: none; }
  .af-aufnahmen { opacity: 0; transform: translateY(1.2cqw); }
  .pv-agentfenster[data-step='3'] .af-agent { opacity: 0; transform: translateY(-1.2cqw); }
  .pv-agentfenster[data-step='3'] .af-aufnahmen { opacity: 1; transform: none; }

  .af-ansicht-kopf { position: relative; display: grid; gap: 0.25cqw; }
  .af-ansicht-titel { font-size: 2cqw; font-weight: 600; line-height: 1.1; }
  .af-ansicht-unter { font-size: 1.3cqw; color: var(--af-leise); }
  .af-kopf-knopf {
    position: absolute; right: 0; top: 0.2cqw;
    font-size: 1.2cqw; padding: 0.4cqw 0.9cqw;
    border: 1px solid var(--af-linie-stark); border-radius: var(--af-r-knopf);
    background: var(--af-hoeher); color: var(--af-text);
  }

  .af-raster {
    display: grid;
    grid-template-columns: 19.5cqw 1fr 19.5cqw;
    gap: 1cqw;
    min-height: 0;
  }
  .af-spalte { display: grid; grid-template-rows: auto 1fr; gap: 1cqw; min-height: 0; }
  .af-aufnahmen .af-spalte { grid-template-rows: 1fr; }

  /* -------------------------------------------------------------- Bausteine */
  .af-feld {
    background: var(--af-erhoht);
    border: 1px solid var(--af-linie);
    border-radius: var(--af-r-karte);
    padding: 0.8cqw;
    display: grid;
    gap: 0.6cqw;
    align-content: start;
    min-height: 0;
    overflow: hidden;
  }
  .af-feld-wachsend { grid-template-rows: auto 1fr auto; align-content: stretch; }
  .af-feld-kopf { display: flex; align-items: center; justify-content: space-between; gap: 0.5cqw; min-height: 1.9cqw; }
  .af-feld-titel { font-size: 1.35cqw; font-weight: 600; }

  .af-plus { position: relative; width: 1.3cqw; height: 1.3cqw; flex: none; }
  .af-plus::before, .af-plus::after {
    content: ''; position: absolute; inset: 0; margin: auto; background: var(--af-leise);
  }
  .af-plus::before { width: 1cqw; height: 1px; }
  .af-plus::after { width: 1px; height: 1cqw; }

  .af-ws {
    display: flex; align-items: center; gap: 0.6cqw;
    font-size: 1.3cqw; color: var(--af-leise);
    padding: 0.4cqw 0.55cqw; border-radius: var(--af-r-knopf);
  }
  .af-ws-aktiv { background: var(--af-hoeher); color: var(--af-text); }
  .af-punkt { width: 0.7cqw; height: 0.7cqw; border-radius: 999px; background: var(--p); flex: none; }

  .af-chat-verlauf {
    min-height: 0; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .af-blase {
    align-self: flex-end;
    max-width: 94%;
    font-size: 1.2cqw;
    background: var(--af-akzent-flaeche);
    border: 1px solid var(--af-akzent-rand);
    border-radius: var(--af-r-knopf);
    padding: 0.45cqw 0.65cqw;
  }
  .af-blase-agent {
    align-self: flex-start;
    margin-top: 0.5cqw;
    background: var(--af-hoeher);
    border-color: var(--af-linie-stark);
    color: var(--af-leise);
  }

  .af-komposition {
    background: var(--af-hoeher);
    border: 1px solid var(--af-linie);
    border-radius: var(--af-r-knopf);
    padding: 0.55cqw;
    display: grid;
    gap: 0.45cqw;
  }
  .af-regler { display: grid; gap: 0.25cqw; }
  .af-regler-titel { font-size: 1.05cqw; color: var(--af-leise); }
  .af-segmente {
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
    gap: 1px; padding: 1px;
    border: 1px solid var(--af-linie-stark); border-radius: var(--af-r-knopf);
  }
  .af-segment {
    font-size: 1cqw; text-align: center; color: var(--af-leise);
    padding: 0.25cqw 0.05cqw; border-radius: calc(var(--af-r-knopf) - 1px);
    white-space: nowrap; line-height: 1.25;
  }
  .af-segment.af-an { background: var(--af-akzent-flaeche); color: var(--af-akzent); }

  .af-eingabe {
    display: flex; align-items: center; gap: 0.45cqw;
    background: var(--af-grund);
    border: 1px solid var(--af-linie-stark);
    border-radius: var(--af-r-knopf);
    padding: 0.35cqw 0.4cqw;
  }
  .af-platzhalter { flex: 1; font-size: 1.15cqw; color: #6a6a6a; white-space: nowrap; overflow: hidden; }
  .af-ikon { width: 1.3cqw; height: 1.3cqw; flex: none; position: relative; }
  .af-ikon-buch::before {
    content: ''; position: absolute; inset: 0.1cqw;
    border: 1px solid var(--af-leise); border-radius: 0.15cqw; border-left-width: 0.3cqw;
  }
  .af-ikon-mikro::before {
    content: ''; position: absolute; left: 50%; top: 0.1cqw;
    width: 0.5cqw; height: 0.75cqw; margin-left: -0.25cqw;
    border-radius: 999px; background: var(--af-leise);
  }
  .af-ikon-mikro::after {
    content: ''; position: absolute; left: 50%; bottom: 0.1cqw;
    width: 0.7cqw; height: 0.3cqw; margin-left: -0.35cqw;
    border: 1px solid var(--af-leise); border-top: 0; border-radius: 0 0 0.35cqw 0.35cqw;
  }
  .af-senden {
    width: 1.7cqw; height: 1.7cqw; flex: none;
    border-radius: var(--af-r-knopf); background: var(--af-akzent); position: relative;
  }
  .af-senden::before {
    content: ''; position: absolute; left: 50%; top: 50%;
    width: 0.5cqw; height: 0.5cqw; margin: -0.12cqw 0 0 -0.25cqw;
    border-left: 0.18cqw solid #06251a; border-top: 0.18cqw solid #06251a;
    transform: rotate(45deg);
  }

  /* ----------------------------------------------------------------- Mitte */
  .af-mitte { display: grid; grid-template-rows: 1fr 12.6cqw; gap: 1cqw; min-height: 0; }
  .af-mitte-abspiel { grid-template-rows: 1fr 8.6cqw; }

  .af-buehne {
    position: relative;
    background: #000;
    border: 1px solid var(--af-linie);
    border-radius: var(--af-r-karte);
    overflow: hidden;
  }

  /* Das einzige Fenster auf dem unsichtbaren Agenten-Desktop. */
  .af-zielfenster {
    position: absolute;
    left: 7%; top: 8%; width: 70%; height: 80%;
    background: #fbfbfb;
    border-radius: 0.4cqw;
    box-shadow: 0 1.2cqw 2.6cqw rgb(0 0 0 / 0.7);
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    overflow: hidden;
    color: #1d1d1f;
  }
  .af-zf-leiste {
    display: flex; align-items: center; justify-content: space-between;
    background: #ececed; border-bottom: 1px solid #dcdcde;
    padding: 0.35cqw 0.6cqw;
  }
  .af-zf-titel { font-size: 1.1cqw; font-weight: 600; }
  .af-zf-knoepfe { display: flex; gap: 1cqw; }
  .af-zf-knoepfe i { position: relative; width: 0.9cqw; height: 0.9cqw; }
  .af-zf-min::before {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: #6d6d72;
  }
  .af-zf-max::before {
    content: ''; position: absolute; inset: 0.12cqw; border: 1px solid #6d6d72;
  }
  .af-zf-zu::before, .af-zf-zu::after {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: #6d6d72;
  }
  .af-zf-zu::before { transform: rotate(45deg); }
  .af-zf-zu::after { transform: rotate(-45deg); }

  .af-zf-werkzeuge {
    display: flex; gap: 0.4cqw; padding: 0.4cqw 0.6cqw;
    border-bottom: 1px solid #e4e4e6; background: #f5f5f6;
  }
  .af-zf-wz {
    font-size: 0.95cqw; color: #2c2c30;
    padding: 0.2cqw 0.6cqw; border-radius: 0.2cqw;
    border: 1px solid #d7d7da; background: #fff;
  }
  .af-zf-wz-aus { color: #b0b0b5; background: #efeff0; border-color: #e2e2e5; }
  .af-zf-koerper { padding: 0.6cqw; display: grid; gap: 0.4cqw; align-content: start; }
  .af-zf-zeile { display: grid; grid-template-columns: 5.4cqw 1fr; align-items: center; gap: 0.5cqw; }
  .af-zf-marke { font-size: 1.05cqw; color: #5a5a5e; }
  .af-zf-feld {
    position: relative; height: 1.85cqw;
    border: 1px solid #c9c9cd; border-radius: 0.2cqw; background: #fff;
    display: flex; align-items: center; padding: 0 0.45cqw;
    font-size: 1.05cqw; color: #1d1d1f;
    transition: border-color 260ms var(--ease-out), box-shadow 260ms var(--ease-out);
  }
  /* Die Liste der bereits erfassten Belege: hier wird der Zustandswechsel sichtbar. */
  .af-zf-liste {
    margin: 0 0.6cqw 0.6cqw;
    border: 1px solid #d5d5d9; border-radius: 0.2cqw; background: #fff;
    display: grid; align-content: start; overflow: hidden; min-height: 0;
  }
  .af-zf-lz {
    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5cqw;
    padding: 0.35cqw 0.6cqw; font-size: 1cqw; color: #2c2c30;
    border-bottom: 1px solid #eeeef0;
  }
  .af-zf-lz span:last-child { text-align: right; }
  .af-zf-lkopf { background: #f2f2f4; color: #5a5a5e; font-weight: 600; }
  .af-zf-lneu {
    background: #e7f5ef; color: #14573f;
    opacity: 0; transform: translateY(-0.5cqw);
    transition: opacity 320ms var(--ease-out), transform 320ms var(--ease-out);
  }
  .pv-agentfenster[data-step='2'] .af-agent .af-zf-lneu,
  .af-zielfenster-fertig .af-zf-lneu { opacity: 1; transform: none; }

  .af-zf-fuss {
    display: flex; align-items: center; justify-content: flex-end; gap: 0.5cqw;
    padding: 0.5cqw 0.6cqw; border-top: 1px solid #e4e4e6; background: #f5f5f6;
  }
  .af-zf-status {
    margin-right: auto; font-size: 1cqw; font-weight: 600; color: #156b4c;
    display: flex; align-items: center; gap: 0.35cqw;
    opacity: 0; transition: opacity 300ms var(--ease-out);
  }
  .af-zf-status::before {
    content: ''; width: 0.55cqw; height: 0.55cqw; border-radius: 999px; background: #156b4c;
  }
  .af-zf-knopf {
    font-size: 1.05cqw; padding: 0.3cqw 0.8cqw; border-radius: 0.2cqw;
    border: 1px solid #c9c9cd; background: #f3f3f4; color: #1d1d1f;
  }
  .af-zf-knopf-haupt { background: #1c7957; border-color: #176247; color: #fff; }

  /* Das getippte Ergebnis steht erst ab Schritt 1 im Feld. */
  .af-zf-wert { opacity: 0; transition: opacity 260ms var(--ease-out); }
  .pv-agentfenster[data-step='1'] .af-agent .af-zf-wert,
  .pv-agentfenster[data-step='2'] .af-agent .af-zf-wert { opacity: 1; }
  .af-aufnahmen .af-zf-wert { opacity: 1; }
  .pv-agentfenster[data-step='1'] .af-agent .af-zf-ziel {
    border-color: #1c7957; box-shadow: 0 0 0 0.2cqw rgb(28 121 87 / 0.18);
  }
  .pv-agentfenster[data-step='2'] .af-agent .af-zf-status,
  .af-zielfenster-fertig .af-zf-status { opacity: 1; }

  /* Live-Marke */
  .af-marke-live {
    position: absolute; left: 1cqw; top: 1cqw;
    display: flex; align-items: center; gap: 0.45cqw;
    background: rgb(8 8 8 / 0.82); border: 1px solid var(--af-linie-stark);
    border-radius: 999px; padding: 0.25cqw 0.7cqw;
    font-size: 1.1cqw; color: var(--af-text);
  }
  .af-puls { width: 0.6cqw; height: 0.6cqw; border-radius: 999px; background: var(--af-akzent); }
  /* Der Live-Punkt sitzt auf der Agent-Buehne und laeuft nur, solange sie sichtbar ist. */
  .pv-agentfenster.is-live:not([data-step='3']) .af-puls { animation: af-puls 1.9s var(--ease-in-out) infinite; }
  @keyframes af-puls {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.32; transform: scale(0.7); }
  }

  /* Virtueller Zeiger: eine Position je Schritt, die Bahn macht transform. */
  .af-zeiger {
    position: absolute; left: 0; top: 0;
    width: 1.9cqw; height: 2.8cqw;
    transform: translate(48cqw, 25cqw);
    /* Bewegung auf der Flaeche: ease-in-out. Nur das Ausblenden ist ein Austritt. */
    transition: transform 640ms var(--ease-in-out), opacity 300ms var(--ease-out);
  }
  .af-zeiger svg {
    width: 100%; height: 100%; display: block;
    filter: drop-shadow(0 0.18cqw 0.35cqw rgb(0 0 0 / 0.7));
  }
  .pv-agentfenster[data-step='1'] .af-zeiger { transform: translate(22cqw, 13.3cqw); }
  .pv-agentfenster[data-step='2'] .af-zeiger { transform: translate(40.6cqw, 29.8cqw); }
  .pv-agentfenster[data-step='3'] .af-zeiger { opacity: 0; }

  .af-ring {
    position: absolute; left: -2cqw; top: -2cqw;
    width: 4cqw; height: 4cqw; border-radius: 999px;
    border: 0.22cqw solid var(--af-akzent);
    opacity: 0; transform: scale(0.8);
    transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out);
  }
  .pv-agentfenster[data-step='1'] .af-ring,
  .pv-agentfenster[data-step='2'] .af-ring { opacity: 0.9; transform: scale(1); }
  /* Der Klickring bleibt stehen; nur der Nachhall darueber pulst. */
  .af-ring::after {
    content: ''; position: absolute; inset: -0.22cqw;
    border-radius: 999px; border: 0.22cqw solid var(--af-akzent);
    opacity: 0;
  }
  .pv-agentfenster.is-live[data-step='1'] .af-ring::after,
  .pv-agentfenster.is-live[data-step='2'] .af-ring::after {
    animation: af-ring 1.9s var(--ease-out) infinite;
  }
  @keyframes af-ring {
    0% { opacity: 0.8; transform: scale(0.72); }
    70%, 100% { opacity: 0; transform: scale(1.5); }
  }

  /* Der wirkungslose Klick bleibt als roter Ring an seiner Stelle stehen. */
  .af-geisterring {
    position: absolute; left: 12.5cqw; top: 4.6cqw;
    width: 3.2cqw; height: 3.2cqw; border-radius: 999px;
    border: 0.22cqw solid var(--af-warnung);
    background: rgb(217 112 92 / 0.14);
    opacity: 0; transform: scale(0.85);
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out);
  }
  .pv-agentfenster[data-step='2'] .af-geisterring { opacity: 1; transform: scale(1); }

  /* Die aufgezeichnete Zeigerspur: ein Punkt je Aktion, rot wo nichts geschah. */
  .af-spurpunkt {
    position: absolute; left: var(--x); top: var(--y);
    width: 1.1cqw; height: 1.1cqw; margin: -0.55cqw 0 0 -0.55cqw;
    border-radius: 999px;
    border: 0.2cqw solid var(--af-akzent);
    background: rgb(39 184 131 / 0.22);
  }
  .af-spurpunkt-warn { border-color: var(--af-warnung); background: rgb(217 112 92 / 0.24); }

  /* -------------------------------------------------------------- Terminal */
  .af-terminal { grid-template-rows: auto 1fr; align-content: stretch; }
  .af-term-flaeche {
    background: var(--af-grund);
    border: 1px solid var(--af-linie);
    border-radius: var(--af-r-knopf);
    padding: 0.5cqw 0.7cqw;
    font-size: 1.1cqw;
    line-height: 1.6;
    color: var(--af-text);
    overflow: hidden;
    white-space: nowrap;
  }
  .af-term-pfad { color: var(--tat-tippen); }
  .af-term-gruen { color: var(--af-akzent); }
  .af-term-leise { color: var(--af-leise); }
  .af-term-lauf { position: relative; display: flex; align-items: center; }
  .af-term-var { position: absolute; left: 0; opacity: 0; transition: opacity 260ms var(--ease-out); }
  .pv-agentfenster[data-step='0'] .af-term-var[data-von='0'],
  .pv-agentfenster[data-step='1'] .af-term-var[data-von='1'],
  .pv-agentfenster[data-step='2'] .af-term-var[data-von='2'],
  .pv-agentfenster[data-step='3'] .af-term-var[data-von='2'] { opacity: 1; }
  .af-term-lauf .af-karet { margin-left: 13.6cqw; }
  .af-karet {
    display: inline-block; width: 0.65cqw; height: 1.1cqw;
    background: var(--af-akzent); margin-left: 0.35cqw; vertical-align: -0.15cqw;
  }
  /* Der Caret steht im Terminal der Agent-Ansicht, in Schritt 3 ist die weg. */
  .pv-agentfenster.is-live:not([data-step='3']) .af-karet { animation: af-karet 1.1s steps(1) infinite; }
  @keyframes af-karet { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }

  /* -------------------------------------------------------------- Activity */
  .af-stop {
    font-size: 1.05cqw; padding: 0.22cqw 0.6cqw;
    border-radius: var(--af-r-knopf);
    border: 1px solid var(--af-warnung-rand);
    background: var(--af-warnung-flaeche);
    color: var(--af-warnung);
    transition: opacity 280ms var(--ease-out);
  }

  .af-verlauf { display: grid; align-content: start; gap: 0.55cqw; min-height: 0; overflow: hidden; }
  .af-eintrag {
    display: grid; grid-template-columns: 2.9cqw 1fr; gap: 0.5cqw;
    opacity: 0; transform: translateY(0.8cqw);
    transition: opacity 320ms var(--ease-out), transform 320ms var(--ease-out);
  }
  .af-schritt { opacity: 1; transform: none; }
  .af-schritt .af-schiene { min-height: 1.5cqw; }
  .pv-agentfenster[data-step='0'] .af-eintrag[data-von='0'],
  .pv-agentfenster[data-step='1'] .af-eintrag[data-von='0'],
  .pv-agentfenster[data-step='1'] .af-eintrag[data-von='1'],
  .pv-agentfenster[data-step='2'] .af-eintrag[data-von='0'],
  .pv-agentfenster[data-step='2'] .af-eintrag[data-von='1'],
  .pv-agentfenster[data-step='2'] .af-eintrag[data-von='2'],
  .pv-agentfenster[data-step='3'] .af-eintrag[data-von] { opacity: 1; transform: none; }

  .af-rail { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3cqw; }
  .af-zeit { font-size: 1cqw; color: #6f6f6f; line-height: 1.2; }
  .af-schiene { width: 0.2cqw; flex: 1; border-radius: 999px; background: var(--af-linie-stark); }
  .af-eintrag[data-tat='clicking'] .af-schiene { background: var(--tat-klick); }
  .af-eintrag[data-tat='typing'] .af-schiene { background: var(--tat-tippen); }
  .af-eintrag[data-tat='windows'] .af-schiene { background: var(--tat-fenster); }
  .af-warnt .af-schiene { background: var(--af-warnung); }

  .af-kasten { display: grid; gap: 0.15cqw; align-content: start; min-width: 0; }
  .af-tat { font-size: 1cqw; color: var(--af-leise); }
  .af-eintrag[data-tat='clicking'] .af-tat { color: var(--tat-klick); }
  .af-eintrag[data-tat='typing'] .af-tat { color: var(--tat-tippen); }
  .af-eintrag[data-tat='windows'] .af-tat { color: var(--tat-fenster); }
  .af-titel { font-size: 1.3cqw; color: var(--af-text); }
  .af-neben { font-size: 1.05cqw; color: var(--af-leise); line-height: 1.4; }

  .af-warnt .af-kasten {
