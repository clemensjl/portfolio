---
// Was Clemens selbst programmiert: kurz und ehrlich, der Rest steht im KI-Bereich.
import { coding } from '../data/skills';
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="coding">
  <p class="label">{t('coding.title')}</p>
  <dl>
    {coding[lang].map((c) => (
      <div>
        <dt>{c.name}</dt>
        <dd>{c.detail}</dd>
      </div>
    ))}
  </dl>
  <p class="note">{t('coding.note')}</p>
</div>

<style>
  .label { color: var(--muted); font-size: 0.9rem; margin: 0 0 0.7rem; }
  dl { margin: 0; border-top: 1px solid var(--border-soft); }
  dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border-soft);
  }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .note { color: var(--faint); font-size: 0.9rem; margin: 0.9rem 0 0; }
</style>
