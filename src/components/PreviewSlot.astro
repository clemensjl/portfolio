---
// Ordnet dem Feld `preview` aus dem Content die passende Vorschau-Komponente zu.
// Unbekannter Name oder kein Feld: es wird das Projektbild gezeigt.
import type { Lang } from '../i18n';
import Agentfenster from './previews/Agentfenster.astro';
import AgentDeck from './previews/AgentDeck.astro';
import KernSearch from './previews/KernSearch.astro';
import KernMind from './previews/KernMind.astro';
import KernClean from './previews/KernClean.astro';
import Maerchenfuchs from './previews/Maerchenfuchs.astro';
import Lifemate from './previews/Lifemate.astro';

interface Props {
  lang: Lang;
  name?: string;
  image?: string;
  imageAlt?: string;
  // In Links (Kacheln, Karten): Vorschau ist Schmuck, der Linkname kommt aus Titel und Text daneben
  decorative?: boolean;
}

const registry = {
  agentfenster: Agentfenster,
  'agent-deck': AgentDeck,
  'kern-search': KernSearch,
  kernmind: KernMind,
  'kern-clean': KernClean,
  maerchenfuchs: Maerchenfuchs,
  lifemate: Lifemate,
} as const;

const { lang, name, image, imageAlt = '', decorative = false } = Astro.props;
const Preview = name ? registry[name as keyof typeof registry] : undefined;
---

{Preview ? (
  decorative ? <div aria-hidden="true"><Preview lang={lang} /></div> : <Preview lang={lang} />
) : image ? (
  <div class="pv pv-image">
    <img src={image} alt={imageAlt} width="1200" height="675" loading="lazy" decoding="async" />
  </div>
) : null}

<style>
  .pv-image { aspect-ratio: 16 / 9; }
  .pv-image img { width: 100%; height: 100%; object-fit: cover; }
</style>
