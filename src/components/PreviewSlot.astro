---
// Ordnet dem Feld `preview` aus dem Content die echten Screenshots unter
// public/images/shots/<name>/ zu. Unbekannter Name oder kein Feld: es wird das Projektbild gezeigt.
import type { Lang } from '../i18n';
import Shots from './previews/Shots.astro';
import { hasShots } from '../lib/shots';

interface Props {
  lang: Lang;
  name?: string;
  image?: string;
  imageAlt?: string;
  // In Links (Kacheln, Karten): Vorschau ist Schmuck, der Linkname kommt aus Titel und Text daneben
  decorative?: boolean;
}

// Hochformat-Apps bekommen Geraeterahmen auf dem Hintergrund der echten App
const registry: Record<string, { title: string; layout?: 'desktop' | 'phone'; bg?: string }> = {
  'soul-codes': { title: 'Soul Codes' },
  'agent-deck': { title: 'Agent Deck' },
  agentfenster: { title: 'agentfenster' },
  maerchenfuchs: { title: 'Märchenfuchs' },
  lifemate: { title: 'Lifemate' },
  kernmind: { title: 'KernMind' },
  'kern-clean': { title: 'KernClean' },
};

const { lang, name, image, imageAlt = '', decorative = false } = Astro.props;
// Bilder ohne Registry-Eintrag: trotzdem zeigen, Titel ist dann der Slug
const entry = name && hasShots(name) ? (registry[name] ?? { title: name }) : undefined;
---

{entry && name ? (
  decorative ? (
    <div aria-hidden="true"><Shots lang={lang} slug={name} {...entry} /></div>
  ) : (
    <Shots lang={lang} slug={name} {...entry} />
  )
) : image ? (
  <div class="pv pv-image">
    <img src={image} alt={imageAlt} width="1200" height="675" loading="lazy" decoding="async" />
  </div>
) : null}

<style>
  .pv-image { aspect-ratio: 16 / 9; }
  .pv-image img { width: 100%; height: 100%; object-fit: cover; }
</style>
