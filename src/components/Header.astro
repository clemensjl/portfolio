---
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/projects/`, label: t('nav.projects') },
  { href: `/${lang}/startup/`, label: t('nav.startup') },
  { href: `/${lang}/about/`, label: t('nav.about') },
];
const current = Astro.url.pathname;
// Sprachneutraler Pfad für den Sprachumschalter: "/de/projects/" → "/projects/".
const neutralPath = current.replace(/^\/(de|en)(?=\/|$)/, '') || '/';
---

<header class="site-header">
  <a class="brand" href={`/${lang}/`}>
    <img src="/favicon.svg" alt="" width="30" height="30" />
    <span>Clemens Jele</span>
  </a>
  <nav aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
    {items.map((item) => (
      <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <div class="tools">
    <LangSwitch lang={lang} path={neutralPath} />
    <ThemeToggle lang={lang} />
  </div>
</header>

<style>
  .site-header {
    /* Bewusst KEIN .container: Der Header läuft full-bleed über die volle
       Viewport-Breite, damit die Regler (.tools) wirklich ganz rechts am
       Viewport-Rand sitzen — nicht am Rand des zentrierten 64rem-Containers,
       wo auf breiten Screens Browser-Extension-Popups (Chrome-Übersetzer,
       oben rechts) sie überdecken. Inset 1.25rem = padding-inline des
       Containers, dadurch identisches Bild bis ~1064px Viewport-Breite. */
    width: 100%;
    padding-inline: 1.25rem;
    display: flex;
    align-items: center;
    /* Fallback für Zeilen ohne Auto-Margin (z. B. .tools allein bei stark
       vergrößerter Root-Schrift): rechtsbündig statt links gestrandet.
       In Zeile 1 wirkungslos — die Auto-Margins schlucken den Freiraum. */
    justify-content: flex-end;
    gap: 0.9rem 1.4rem;
    flex-wrap: wrap;
    padding-block: 1.4rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 600;
    font-size: 1.05rem;
    /* schiebt Nav + Tools nach rechts — die Regler sitzen damit als letztes
       Element bündig am rechten Rand (Google-Translate-Popup-Zone meiden) */
    margin-right: auto;
  }
  .brand:hover { text-decoration: none; }
  .tools { display: flex; align-items: center; gap: 0.6rem; }
  nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    /* Wenn Nav + Tools auf eine eigene Zeile umbrechen, bleiben sie rechtsbündig. */
    margin-left: auto;
  }
  /* Schmale Viewports: Brand + Regler in Zeile 1 (Regler ganz rechts),
     Navigation als eigene Zeile darunter — statt drei unruhiger Zeilen.
     Breakpoint 740px: darüber passt alles sicher in eine Zeile (~694px nötig).
     Engere Lücke + Brand auf 1rem, damit Zeile 1 bei 390px wirklich passt;
     margin-left:auto hält die Regler auch dann rechts, falls sie doch umbrechen. */
  @media (max-width: 740px) {
    .site-header { column-gap: 0.6rem; }
    .brand { font-size: 1rem; gap: 0.5rem; }
    .tools { margin-left: auto; gap: 0.5rem; }
    nav {
      order: 3;
      flex-basis: 100%;
      margin-left: 0;
    }
  }
  nav a {
    position: relative;
    color: var(--muted);
    font-weight: 500;
    transition: color 150ms ease;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.25em;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }
  nav a:hover { color: var(--text); text-decoration: none; }
  nav a:hover::after,
  nav a:focus-visible::after { transform: scaleX(1); }
  nav a[aria-current='page'] { color: var(--accent); }
  nav a[aria-current='page']::after { transform: scaleX(1); background: var(--accent-dim); }
</style>
