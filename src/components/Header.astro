---
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/projects/`, label: t('nav.projects') },
  { href: `/${lang}/startup/`, label: t('nav.startup') },
  { href: `/${lang}/about/`, label: t('nav.about') },
];
const current = Astro.url.pathname;
// Sprachneutraler Pfad für den Sprachumschalter: "/de/projects/" → "/projects/".
const neutralPath = current.replace(/^\/(de|en)(?=\/|$)/, '') || '/';
---

<header class="container site-header">
  <a class="brand" href={`/${lang}/`}>
    <img src="/favicon.svg" alt="" width="28" height="28" />
    <span>Clemens Jele</span>
  </a>
  <div class="header-right">
    <nav aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      {items.map((item) => (
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="tools">
      <LangSwitch lang={lang} path={neutralPath} />
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .site-header {
    /* Als Flex-Kind von <body> verhindern die Auto-Margins des .container das
       Stretchen — der Header schrumpfte auf Inhaltsbreite und wirkte zentriert.
       width: 100% stellt das gedachte Layout her: Brand links, Tools rechts,
       bündig mit Content und Footer. */
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 600;
  }
  .brand:hover { text-decoration: none; }
  .header-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .tools { display: flex; align-items: center; gap: 0.5rem; }
  nav { display: flex; gap: 1.1rem; flex-wrap: wrap; }
  nav a {
    position: relative;
    color: var(--muted);
    transition: color 150ms ease;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.25em;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }
  nav a:hover { color: var(--text); text-decoration: none; }
  nav a:hover::after,
  nav a:focus-visible::after { transform: scaleX(1); }
  nav a[aria-current='page'] { color: var(--accent); }
  nav a[aria-current='page']::after { transform: scaleX(1); background: var(--accent-dim); }
</style>
