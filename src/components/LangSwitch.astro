---
import { languages, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Sprachneutraler Pfad, z. B. "/projects/wincleaner/". */
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const options = Object.keys(languages) as Lang[];
---

<div class="seg" role="group" aria-label={t('lang.label')}>
  {options.map((l) =>
    l === lang ? (
      <span class="seg-item is-active" aria-current="true" lang={l}>
        {l.toUpperCase()}
      </span>
    ) : (
      <a
        class="seg-item"
        href={`/${l}${path}`}
        hreflang={l}
        lang={l}
        rel="alternate"
        aria-label={languages[l]}
      >
        {l.toUpperCase()}
      </a>
    )
  )}
</div>
