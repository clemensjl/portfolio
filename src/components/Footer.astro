---
import LangSwitch from './LangSwitch.astro';
import { getCollection } from 'astro:content';
import { useTranslations, EMAIL_HREF, GITHUB_URL, SOCIALS, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
  // Startseite: grosser Kontaktblock ueber der Fusszeile
  big?: boolean;
}

const { lang, path, big = false } = Astro.props;
const t = useTranslations(lang);
const email = EMAIL_HREF.replace('mailto:', '');
// Vorbefuellte erste Zeile im WhatsApp-Chat
const waText = lang === 'de' ? 'Hallo Clemens, ' : 'Hi Clemens, ';

// Websites der Projekte, gesammelt aus dem Content: Live-Seite, sonst Repo, sonst Download
const host = (u: string) => {
  const url = new URL(u);
  return url.host.replace(/^www\./, '') + url.pathname.replace(/\/$/, '');
};
const ofLang = (e: { id: string }) => e.id.startsWith(`${lang}/`);
const sites = big
  ? [...(await getCollection('ventures', ofLang)), ...(await getCollection('projects', ofLang))]
      .sort((a, b) => (a.data.flagship ?? 99) - (b.data.flagship ?? 99) || a.data.order - b.data.order)
      .flatMap((e) => {
        const d = e.data as { title: string; live?: string; repo?: string; download?: string };
        const href = d.live ?? d.repo ?? d.download;
        return href ? [{ title: d.title, href, host: host(href) }] : [];
      })
  : [];
---

<footer id="contact">
  {big && (
    <div class="container contact">
      <h2 data-reveal>{t('home.contactTitle')}</h2>
      <p class="lede" data-reveal style="--i:1">{t('home.contactText')}</p>
      <p class="mail-wrap" data-reveal style="--i:2">
        <a class="mail" href={EMAIL_HREF}>
          <span>{email}</span>
          <span class="mail-arrow" aria-hidden="true">↗</span>
        </a>
      </p>
      <div class="channels" data-reveal style="--i:3">
        <!-- Nummer kommt erst nach Klick von api/kontakt.js (IP-Pruefung gegen VPN, Proxy, Tor, Rechenzentren) -->
        <div class="phone" data-phone data-wa-text={waText}>
          <button type="button" class="btn" data-phone-reveal>{t('contact.reveal')}</button>
          <ul class="pills" data-phone-links hidden>
            <li><a class="btn" data-tel href="#">{t('contact.phone')} <span class="mono" data-tel-label></span></a></li>
            <li><a class="btn btn-primary" data-wa href="#" rel="noopener" target="_blank">{t('contact.whatsapp')} <span class="arrow" aria-hidden="true">↗</span></a></li>
          </ul>
          <p class="phone-note" data-phone-denied hidden>{t('contact.denied')}</p>
        </div>
        <div class="lists">
          <div>
            <h3>{t('contact.profiles')}</h3>
            <ul>
              {SOCIALS.map((s) => (
                <li><a href={s.href} rel="me noopener">{s.label} <span class="arrow" aria-hidden="true">↗</span></a></li>
              ))}
            </ul>
          </div>
          {sites.length > 0 && (
            <div>
              <h3>{t('contact.sites')}</h3>
              <ul class="sites">
                {sites.map((p) => (
                  <li><a href={p.href} rel="noopener"><span>{p.title}</span> <span class="mono host">{p.host}</span></a></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  )}
  <div class="container inner">
    <span>© 2026 Clemens Jele</span>
    <div class="links">
      {!big && <a href={EMAIL_HREF}>{t('footer.email')}</a>}
      <a href={GITHUB_URL} rel="me noopener">{t('footer.github')}</a>
      <LangSwitch lang={lang} path={path} />
    </div>
  </div>
</footer>

<script>
  // Telefonnummer erst auf Klick vom Server holen; der gibt sie nur ohne VPN/Proxy/Tor/Rechenzentrum heraus.
  document.querySelectorAll<HTMLElement>('[data-phone]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('[data-phone-reveal]');
    const links = box.querySelector<HTMLElement>('[data-phone-links]');
    const denied = box.querySelector<HTMLElement>('[data-phone-denied]');
    btn?.addEventListener('click', async () => {
      btn.disabled = true;
      try {
        const r = await fetch('/api/kontakt/', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const d = await r.json();
        if (!r.ok || !d.ok) throw new Error('denied');
        const tel = box.querySelector<HTMLAnchorElement>('[data-tel]')!;
        tel.href = d.tel;
        box.querySelector<HTMLElement>('[data-tel-label]')!.textContent = d.phone;
        box.querySelector<HTMLAnchorElement>('[data-wa]')!.href = `${d.whatsapp}?text=${encodeURIComponent(box.dataset.waText ?? '')}`;
        links?.removeAttribute('hidden');
      } catch {
        denied?.removeAttribute('hidden');
      }
      btn.remove();
    });
  });
</script>

<style>
  .phone { margin-bottom: 2.5rem; }
  .phone .pills { margin: 0; }
  /* .pills setzt display: flex und wuerde das hidden-Attribut sonst ueberstimmen */
  .phone [hidden] { display: none; }
  .phone-note { color: var(--muted); margin: 0; max-width: 34rem; }
  footer { border-top: 1px solid var(--border-soft); margin-top: 4rem; color: var(--muted); }
  .contact { padding-block: clamp(5rem, 14vh, 10rem) clamp(3rem, 8vh, 6rem); }
  .contact h2 { color: var(--text); margin-bottom: 1rem; }
  .contact .lede { margin-bottom: 2.5rem; }
  .mail {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 0.6rem + 5.4vw, 5.5rem);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.05;
    color: var(--text);
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 0% 0.06em;
    padding-bottom: 0.12em;
    transition: background-size 260ms var(--ease-out), color var(--dur-quick) ease;
  }
  .mail-wrap { margin: 0; }
  .mail:hover { text-decoration: none; color: var(--accent); }
  .mail-arrow { font-size: 0.6em; transition: transform var(--dur-quick) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .mail:hover { background-size: 100% 0.06em; }
    .mail:hover .mail-arrow { transform: translate(0.12em, -0.12em); }
  }

  .channels { margin-top: clamp(2.5rem, 6vh, 4rem); }
  .pills { list-style: none; margin: 0 0 2.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pills .mono { color: var(--muted); }
  .lists {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    border-top: 1px solid var(--border-soft);
    padding-top: 2rem;
  }
  .lists h3 { font-size: 0.9rem; font-weight: 500; color: var(--muted); margin: 0 0 1rem; }
  .lists ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .sites { grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem 2rem; }
  .lists a { color: var(--text); display: inline-flex; gap: 0.6rem; align-items: baseline; }
  .sites a { display: flex; flex-direction: column; gap: 0.1rem; }
  .lists a:hover { color: var(--accent); text-decoration: none; }
  .host { color: var(--faint); font-size: 0.8rem; overflow-wrap: anywhere; }
  @media (max-width: 700px) { .lists { grid-template-columns: 1fr; } }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem;
    font-size: 0.9rem;
  }
  .links { display: flex; gap: 1.25rem; }
  .links a { color: var(--muted); }
  .links a:hover { color: var(--text); }
</style>
