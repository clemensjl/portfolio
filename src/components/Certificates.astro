---
// Zertifikate als Lernpfad in drei Etappen. Abgeschlossene zeigen den Nachweis-Link,
// alles andere ist klar als geplant oder in Arbeit markiert.
import { certificates, type CertPhase } from '../data/certificates';
import { useTranslations, type Lang, type UiKey } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const phases: CertPhase[] = ['now', 'next', 'later'];
const statusLabel = {
  planned: t('certs.planned'),
  learning: t('certs.learning'),
  done: t('certs.done'),
};
const done = certificates.filter((c) => c.status === 'done').length;
---

<div class="certs">
  <div class="certs-head">
    <p class="kicker mono" data-reveal>{t('certs.kicker')}</p>
    <h2 id="certs-title" data-reveal>{t('certs.title')}</h2>
    <p class="lede" data-reveal style="--i:1">{t('certs.lede')}</p>
    <p class="count mono" data-reveal style="--i:2">{done} / {certificates.length} {t('certs.count')}</p>
  </div>
  <div class="phases">
    {phases.map((ph, i) => (
      <section class="phase" data-reveal style={`--i:${i}`} aria-labelledby={`certs-${ph}`}>
        <h3 id={`certs-${ph}`}>{t(`certs.phase.${ph}` as UiKey)}</h3>
        <ul>
          {certificates.filter((c) => c.phase === ph).map((c) => (
            <li class:list={['cert', `is-${c.status}`]}>
              <a href={c.credential ?? c.url} rel="noopener">
                <span class="name">{c.name}</span>
                <span class="issuer">{c.issuer}</span>
                <span class="topic">{c.topic[lang]}</span>
              </a>
              <span class="status mono">{statusLabel[c.status]}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</div>

<style>
  .certs-head { max-width: 46rem; margin-bottom: clamp(2rem, 5vh, 3.5rem); }
  .kicker { color: var(--accent); margin: 0 0 1rem; }
  .certs-head h2 { margin-bottom: 1.25rem; }
  .certs-head .lede { margin: 0 0 1rem; }
  .count { color: var(--muted); margin: 0; font-size: 0.9rem; }
  .phases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .phase h3 {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 0.9rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .phase ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .cert {
    position: relative;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--bg-raised);
    transition: border-color var(--dur-quick) ease;
  }
  .cert:hover { border-color: var(--border); }
  .cert a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    padding-right: 6.5rem;
    color: var(--text);
  }
  .cert a:hover { text-decoration: none; }
  .name { font-weight: 600; line-height: 1.3; }
  .issuer { color: var(--muted); font-size: 0.9rem; }
  .topic { color: var(--faint); font-size: 0.85rem; margin-top: 0.2rem; }
  .status {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    pointer-events: none;
  }
  .is-learning .status { color: var(--text); border-color: var(--muted); }
  .is-done { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .is-done .status { color: var(--bg); background: var(--accent); border-color: var(--accent); }
  @media (max-width: 900px) { .phases { grid-template-columns: 1fr; } }
</style>
