---
// Hero-Board im Stil eines Agenten-Leitstands: jedes laufende Projekt ist eine Session mit
// Status und den letzten Log-Zeilen. Daten in src/data/now.ts. Die Zeilen laufen beim Laden
// einmal gestaffelt ein, das ist die einzige Bewegung ohne Zutun des Besuchers.
import { sessions, nowUpdated, type SessionState } from '../data/now';
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const label: Record<SessionState, string> = {
  working: t('now.working'),
  waiting: t('now.waiting'),
  done: t('now.done'),
};
const count = (s: SessionState) => sessions.filter((x) => x.state === s).length;
const summary = (['working', 'waiting', 'done'] as const)
  .filter((s) => count(s) > 0)
  .map((s) => `${count(s)} ${t(`now.sum.${s}`)}`)
  .join(', ');
const stand = new Date(nowUpdated).toLocaleDateString(lang === 'de' ? 'de-AT' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
// Laufende Verzoegerung ueber alle Zeilen, damit das Board von oben nach unten "anlaeuft"
let line = 0;
---

<section class="board" aria-labelledby="board-title">
  <header class="bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <h2 id="board-title">{t('now.title')}</h2>
    <p class="meta"><span>{summary}</span><time datetime={nowUpdated}>{t('now.updated')} {stand}</time></p>
  </header>
  <ul class="panes">
    {sessions.map((s, i) => (
      <li class={`pane is-${s.state}`} style={`--p:${i}`}>
        <a href={s.href}>
          <span class="pane-head">
            <span class="dot" aria-hidden="true"></span>
            <span class="pane-title">{s.title}</span>
            <span class="state">{label[s.state]}</span>
          </span>
          <span class="log">
            {s.log[lang].map((l, j) => (
              <span class:list={['ln', { last: j === s.log[lang].length - 1 }]} style={`--l:${line++}`}>{l}</span>
            ))}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .board {
    container: board / inline-size;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: 0 50px 100px -50px rgb(0 0 0 / 0.85), inset 0 1px 0 rgb(255 255 255 / 0.04);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .lights { display: flex; gap: 0.35rem; }
  .lights i { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--surface-2); border: 1px solid var(--border); }
  .bar h2 { font-family: var(--font-sans); font-size: 0.92rem; font-weight: 600; letter-spacing: 0; white-space: nowrap; }
  .meta {
    margin: 0 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.1rem 1rem;
    color: var(--muted);
    white-space: nowrap;
    font-size: 0.78rem;
  }
  .meta time { color: var(--faint); }

  .panes {
    list-style: none;
    margin: 0;
    padding: 0.75rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  /* Die erste Session ist die aktive: sie bekommt die volle Breite */
  .pane:first-child { grid-column: 1 / -1; }
  /* Bleibt hinten eine Session allein, fuellt sie die Zeile statt ein Loch zu lassen */
  .pane:nth-child(even):last-child { grid-column: 1 / -1; }
  .pane a {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 0.85rem 1rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border-soft);
    background: var(--bg);
    color: var(--text);
    transition: border-color var(--dur-quick) ease, background-color var(--dur-quick) ease;
  }
  .pane a:hover { text-decoration: none; border-color: color-mix(in srgb, var(--c) 55%, var(--border)); }

  .is-working { --c: var(--st-working); }
  .is-waiting { --c: var(--st-waiting); }
  .is-done { --c: var(--st-done); }

  .pane-head { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
  .dot { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent); }
  .pane-title { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; letter-spacing: -0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .state {
    flex: none;
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--c);
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c) 12%, transparent);
  }

  .log {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .ln::before { content: '> '; color: var(--faint); }
  .ln.last { color: var(--text); }
  /* Nur die oberste Session bekommt die Schreibmarke: eine blinkende Stelle reicht */
  .pane:first-child.is-working .ln.last::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.25em;
    vertical-align: -0.15em;
    background: var(--c);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pane { animation: pane-in 600ms var(--ease-out) both; animation-delay: calc(var(--p) * 90ms + 300ms); }
    .ln { animation: ln-in 380ms var(--ease-out) both; animation-delay: calc(var(--l) * 110ms + 600ms); }
    .pane:first-child.is-working .ln.last::after { animation: caret 1.1s steps(1) infinite; }
    @keyframes pane-in { from { opacity: 0; transform: translateY(0.75rem); } }
    @keyframes ln-in { from { opacity: 0; transform: translateX(-0.4rem); } }
    @keyframes caret { 50% { opacity: 0; } }
  }

  /* Zu schmal fuer zwei Spalten mit ganzem Titel: Sessions untereinander */
  @container board (max-width: 33rem) {
    .panes { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .panes { padding: 0.5rem; gap: 0.5rem; }
    .lights { display: none; }
    .bar h2, .meta time { white-space: nowrap; }
  }
</style>
