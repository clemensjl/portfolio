---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../styles/global.css';
import { useTranslations } from '../i18n';

const de = useTranslations('de');
const en = useTranslations('en');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 | Clemens Jele</title>
    <meta name="description" content="Seite nicht gefunden. Page not found." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main id="main" class="container notfound">
      <h1>404</h1>
      <section>
        <h2>{de('notfound.title')}</h2>
        <p>{de('notfound.text')}</p>
        <a class="btn" href="/de/">{de('notfound.back')}</a>
      </section>
      <section lang="en">
        <h2>{en('notfound.title')}</h2>
        <p>{en('notfound.text')}</p>
        <a class="btn" href="/en/">{en('notfound.back')}</a>
      </section>
    </main>
  </body>
</html>

<style>
  .notfound { padding-block: clamp(4rem, 14vh, 9rem); display: grid; gap: 3rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .notfound h1 { grid-column: 1 / -1; font-size: clamp(5rem, 22vw, 16rem); line-height: 0.85; color: var(--accent); }
  .notfound h2 { font-size: 1.6rem; margin-bottom: 0.75rem; }
  .notfound p { color: var(--muted); }
</style>
