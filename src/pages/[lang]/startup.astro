---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PreviewSlot from '../../components/PreviewSlot.astro';
import { useTranslations, langStaticPaths, type Lang } from '../../i18n';

// Wichtig: klassische Funktionsform. Ein Arrow-Export (`export const getStaticPaths = () => …`)
// bringt den Astro-Compiler dazu, die restliche Frontmatter auf Modulebene zu hoisten,
// wo Astro.params undefined ist — Build bricht mit "Cannot read properties of undefined (reading 'lang')".
export function getStaticPaths() {
  return langStaticPaths;
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const entries = (await getCollection('ventures', (v) => v.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order
);
const ventures = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Base lang={lang} title={`${t('startup.title')} | Clemens Jele`} description={t('startup.description')} path="/startup/">
  <Header lang={lang} path="/startup/" />
  <main id="main" class="container page">
    <h1>Racep Labs</h1>
    <p class="lede">{t('home.startupTeaser')}</p>
    {ventures.map(({ entry, Content }) => {
      const slug = entry.id.split('/')[1];
      return (
        <section class="venture" id={slug} aria-labelledby={`${slug}-title`}>
          <div class="visual" data-autoplay data-reveal="scale">
            <PreviewSlot lang={lang} name={entry.data.preview} />
          </div>
          <div class="cols">
            <div class="side" data-reveal>
              <h2 id={`${slug}-title`} style={`view-transition-name: title-${slug}`}>{entry.data.title}</h2>
              <p class="summary">{entry.data.summary}</p>
              <dl>
                <dt>{t('startup.role')}</dt>
                <dd>{entry.data.role}</dd>
                <dt>{t('startup.status')}</dt>
                <dd>{entry.data.status}</dd>
              </dl>
              {entry.data.stack.length > 0 && (
                <ul class="tags">{entry.data.stack.map((s) => <li class="tag">{s}</li>)}</ul>
              )}
              {entry.data.live && (
                <p class="links"><a class="btn btn-primary" href={entry.data.live} rel="noopener">{t('projects.live')} <span class="arrow" aria-hidden="true">↗</span></a></p>
              )}
            </div>
            <div class="body" data-reveal style="--i:1"><Content /></div>
          </div>
        </section>
      );
    })}
  </main>
  <Footer lang={lang} path="/startup/" />
</Base>

<style>
  .page { padding-block: clamp(3rem, 8vh, 6rem) 2rem; }
  .page h1 { margin-bottom: 1.25rem; }
  .venture { margin-top: clamp(4rem, 10vh, 7rem); padding-top: clamp(3rem, 8vh, 5rem); border-top: 1px solid var(--border-soft); }
  .visual { max-width: 64rem; margin-inline: auto; }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }
  .venture h2 { margin-bottom: 1rem; }
  .summary { color: var(--muted); font-size: 1.1rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.4rem 1.25rem; margin-block: 1.5rem; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .tags { list-style: none; margin: 0; padding: 0; }
  .links { margin-block: 1.5rem 0; }
  .body { max-width: 40rem; font-size: 1.05rem; color: color-mix(in srgb, var(--text) 82%, var(--muted)); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; } }
</style>
