---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Showcase from '../../components/Showcase.astro';
import PreviewSlot from '../../components/PreviewSlot.astro';
import { useTranslations, langStaticPaths, GITHUB_URL, EMAIL_HREF, SOCIALS, type Lang } from '../../i18n';
import AiSkills from '../../components/AiSkills.astro';
import CodingSkills from '../../components/CodingSkills.astro';
import Certificates from '../../components/Certificates.astro';
import { hasShots } from '../../lib/shots';

export function getStaticPaths() {
  return langStaticPaths;
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const ofLang = (e: { id: string }) => e.id.startsWith(`${lang}/`);

const projects = (await getCollection('projects', ofLang)).sort((a, b) => a.data.order - b.data.order);
const ventures = await getCollection('ventures', ofLang);

// Ein Flaggschiff braucht Rang UND Geschichte; fehlt die Geschichte, bleibt es in der Liste unten.
// Seit den echten Screenshots zaehlt zusaetzlich: alle vier Bilder muessen vorliegen.
const isFlagship = (d: { flagship?: number; story?: unknown; preview?: string }) =>
  d.flagship !== undefined && !!d.story && hasShots(d.preview);

// Flaggschiffe kommen aus beiden Collections und werden gemeinsam sortiert.
const flagships = [
  ...projects.map((e) => ({ e, kind: 'project' as const })),
  ...ventures.map((e) => ({ e, kind: 'venture' as const })),
]
  .filter(({ e }) => isFlagship(e.data))
  .sort((a, b) => a.e.data.flagship! - b.e.data.flagship!)
  .map(({ e, kind }, i) => {
    const slug = e.id.split('/')[1];
    const d = e.data;
    const links = [];
    if (d.live) links.push({ href: d.live, label: t('projects.live'), primary: true, external: true });
    if ('download' in d && d.download) links.push({ href: d.download, label: t('projects.download'), primary: !d.live, external: true });
    if ('repo' in d && d.repo) links.push({ href: d.repo, label: t('projects.repo'), external: true });
    links.push(
      kind === 'project'
        ? { href: `/${lang}/projects/${slug}/`, label: t('home.caseStudy') }
        : { href: `/${lang}/startup/#${slug}`, label: t('home.ventureMore') },
    );
    const variants = ['right', 'left', 'stage'] as const; // Rueckfall, wenn der Eintrag keine Variante nennt
    return {
      slug,
      kind,
      d,
      links,
      variant: d.variant ?? variants[i % 3],
      kicker: kind === 'venture' ? `Racep Labs / ${'role' in d ? d.role : ''}` : ('role' in d ? d.role : undefined),
    };
  });

const site = (Astro.site?.href ?? '').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Clemens Jele',
  url: `${site}/${lang}/`,
  image: `${site}/images/clemens.jpg`,
  email: EMAIL_HREF,
  jobTitle: lang === 'de' ? 'Schüler, KI-gestützte Softwareentwicklung' : 'Student, AI-assisted software development',
  description: t('site.description'),
  sameAs: SOCIALS.map((s) => s.href),
  affiliation: { '@type': 'Organization', name: 'Racep Labs' },
};

const rest = projects.filter((p) => !isFlagship(p.data));
const restWithPreview = rest.filter((p) => hasShots(p.data.preview));
const restPlain = rest.filter((p) => !hasShots(p.data.preview));
---

<Base lang={lang} title={t('site.title')} description={t('site.description')} path="/">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Header lang={lang} path="/" />
  <main id="main">
    <section class="hero container">
      <div class="hero-copy">
        <h1>
          <span class="line"><span>Clemens</span></span>
          <span class="line"><span style="--d:1">Jele</span></span>
        </h1>
        <p class="lede hero-sub">{t('hero.sub')}</p>
        <div class="cta">
          <a class="btn btn-primary" href={EMAIL_HREF}>{t('hero.ctaEmail')}</a>
          <a class="btn" href={GITHUB_URL} rel="me noopener">GitHub <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>

      <nav class="hero-index" aria-label={t('hero.indexLabel')}>
        <p class="index-label">{t('hero.indexLabel')}</p>
        <ol>
          {flagships.map((f, i) => (
            <li style={`--d:${i}`}>
              <a href={`#${f.slug}`}>
                <span class="i-title">{f.d.title}</span>
                <span class="i-fact mono">{f.d.facts[0] ? `${f.d.facts[0].value} ${f.d.facts[0].label}` : ''}</span>
                <span class="i-arrow" aria-hidden="true">↓</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>

    <div id="work">
      {flagships.map((f) => (
        <Showcase
          lang={lang}
          id={f.slug}
          title={f.d.title}
          summary={f.d.summary}
          kicker={f.kicker}
          facts={f.d.facts}
          stack={f.d.stack}
          links={f.links}
          story={f.d.story!}
          variant={f.variant}
        >
          <PreviewSlot lang={lang} name={f.d.preview} image={'image' in f.d ? f.d.image : undefined} />
        </Showcase>
      ))}
    </div>

    <section class="more" id="more" aria-labelledby="more-title">
      <div class="container">
        <h2 id="more-title" data-reveal>{t('home.moreTitle')}</h2>
        <p class="lede" data-reveal style="--i:1">{t('home.moreLede')}</p>

        <div class="duo">
          {restWithPreview.map((p, i) => {
            const slug = p.id.split('/')[1];
            return (
              <a class="tile" href={`/${lang}/projects/${slug}/`} data-reveal="scale" style={`--i:${i}`} data-autoplay>
                <PreviewSlot lang={lang} name={p.data.preview} decorative />
                <div class="tile-text">
                  <h3 style={`view-transition-name: title-${slug}`}>{p.data.title}</h3>
                  <p>{p.data.summary}</p>
                </div>
              </a>
            );
          })}
        </div>

        <ul class="rows">
          {restPlain.map((p, i) => {
            const slug = p.id.split('/')[1];
            return (
              <li data-reveal style={`--i:${i}`}>
                <a class="row" href={`/${lang}/projects/${slug}/`}>
                  <h3 style={`view-transition-name: title-${slug}`}>{p.data.title}</h3>
                  <p>{p.data.summary}</p>
                  <span class="row-stack mono">{p.data.stack.slice(0, 3).join(' / ')}</span>
                  <span class="row-arrow" aria-hidden="true">→</span>
                  {p.data.image && <img class="row-shot" src={p.data.image} alt="" width="480" height="270" loading="lazy" decoding="async" />}
                </a>
              </li>
            );
          })}
        </ul>
        <p class="all" data-reveal><a class="btn" href={`/${lang}/projects/`}>{t('home.allProjects')} <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <section class="ki container" id="ki" aria-labelledby="ki-title">
      <AiSkills lang={lang} />
    </section>

    <section class="certs-sec container" id="zertifikate" aria-labelledby="certs-title">
      <Certificates lang={lang} />
    </section>

    <section class="about container" id="about" aria-labelledby="about-title">
      <div class="about-photo" data-reveal="scale">
        <img
          src="/images/clemens.jpg"
          alt={lang === 'de' ? 'Porträt von Clemens Jele' : 'Portrait of Clemens Jele'}
          width="480"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-text">
        <h2 id="about-title" data-reveal>{t('home.aboutTitle')}</h2>
        <p class="lede" data-reveal style="--i:1">{t('home.aboutText')}</p>
        <p data-reveal style="--i:2"><a class="btn" href={`/${lang}/about/`}>{t('home.aboutCta')} <span class="arrow" aria-hidden="true">→</span></a></p>
        <div class="stack" data-reveal style="--i:3"><CodingSkills lang={lang} /></div>
      </div>
    </section>
  </main>
  <Footer lang={lang} path="/" big />
</Base>

<style>
  /* Hero: Name und Satz links, rechts das Inhaltsverzeichnis der Flaggschiffe */
  .hero {
    min-height: calc(100dvh - var(--header-h));
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(2rem, 6vh, 5rem);
  }
  .hero h1 {
    font-size: clamp(3.6rem, 1.2rem + 11vw, 10.5rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    font-weight: 680;
    margin-bottom: clamp(1.5rem, 4vh, 2.75rem);
  }
  .line { display: block; overflow: clip; overflow-clip-margin: 0.12em; padding-bottom: 0.08em; }
  .line > span { display: block; }
  .hero-sub { margin-bottom: 2rem; }
  .cta { display: flex; gap: 0.7rem; flex-wrap: wrap; }

  .index-label { color: var(--muted); font-size: 0.9rem; margin: 0 0 0.75rem; }
  .hero-index ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .hero-index li { border-bottom: 1px solid var(--border); }
  .hero-index a {
    display: grid;
    grid-template-columns: 1fr auto 1.2rem;
    align-items: baseline;
    gap: 1rem;
    padding: clamp(0.8rem, 1.9vh, 1.15rem) 0.25rem;
    color: var(--text);
    transition: color var(--dur-quick) ease;
  }
  .hero-index a:hover { text-decoration: none; color: var(--accent); }
  .i-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .i-fact { color: var(--muted); }
  .i-title { transition: transform 180ms var(--ease-out); }
  .i-arrow { color: var(--faint); transition: transform 180ms var(--ease-out), color var(--dur-quick) ease; }
  .hero-index a:hover .i-arrow { color: var(--accent); }
  /* Bewegte Hover nur mit Maus: auf Touch bliebe der Zustand nach dem Tippen kleben */
  @media (hover: hover) and (pointer: fine) {
    .hero-index a:hover .i-title { transform: translateX(0.6rem); }
    .hero-index a:hover .i-arrow { transform: translateY(3px); }
  }

  /* Auftritt beim Laden: Name faehrt zeilenweise hoch, der Rest folgt gestaffelt */
  @media (prefers-reduced-motion: no-preference) {
    .line > span { animation: hero-rise 900ms var(--ease-out) both; animation-delay: calc(var(--d, 0) * 90ms + 60ms); }
    .hero-sub, .cta { animation: hero-fade-up 700ms var(--ease-out) both; }
    .hero-sub { animation-delay: 320ms; }
    .cta { animation-delay: 400ms; }
    .index-label { animation: hero-fade-up 700ms var(--ease-out) 420ms both; }
    .hero-index li { animation: hero-fade-up 700ms var(--ease-out) both; animation-delay: calc(var(--d) * 60ms + 460ms); }
  }
  @keyframes hero-rise { from { transform: translateY(105%); } }
  @keyframes hero-fade-up { from { opacity: 0; transform: translateY(0.9rem); } }

  /* Beim Wegscrollen sinkt der Hero leicht zurueck: gibt dem ersten Projekt die Buehne */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 901px) {
      .hero-copy, .hero-index {
        animation: hero-out linear both;
        animation-timeline: view();
        animation-range: exit 10% exit 90%;
      }
      @keyframes hero-out { to { opacity: 0; transform: translateY(-6vh) scale(0.97); } }
      /* Tastaturfokus im Hero: nichts ausblenden, worauf gerade der Fokus liegt */
      .hero-copy:has(:focus-visible), .hero-index:has(:focus-visible) { animation: none; }
    }
  }

  /* Weitere Projekte */
  .more, .about { content-visibility: auto; contain-intrinsic-size: auto 120vh; }
  .more { padding-block: clamp(6rem, 14vh, 10rem) 0; border-top: 1px solid var(--border-soft); margin-top: clamp(4rem, 10vh, 8rem); }
  .more h2 { margin-bottom: 1rem; }
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }
  /* Block statt Grid: siehe Kommentar an .pin-inner in Showcase.astro */
  .tile { display: block; color: var(--text); }
  .tile-text { margin-top: 1.1rem; }
  .tile:hover { text-decoration: none; }
  .tile :global(.pv) { transition: transform 200ms var(--ease-out), border-color var(--dur-quick) ease; }
  .tile:hover :global(.pv) { border-color: var(--faint); }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover :global(.pv) { transform: translateY(-4px); }
  }
  .tile h3 { margin-bottom: 0.35rem; }
  .tile p { color: var(--muted); margin: 0; max-width: 34em; }

  .rows { list-style: none; margin: clamp(3rem, 7vh, 5rem) 0 0; padding: 0; border-top: 1px solid var(--border); }
  .rows li { border-bottom: 1px solid var(--border); }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.6fr) auto 1.5rem;
    gap: 0.5rem clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    padding: 1.6rem 0.25rem;
    color: var(--text);
  }
  .row:hover { text-decoration: none; }
  .row p { margin: 0; color: var(--muted); }
  .row-stack { color: var(--faint); white-space: nowrap; }
  .row-arrow { color: var(--faint); transition: transform 180ms var(--ease-out), color var(--dur-quick) ease; }
  .row:hover .row-arrow { color: var(--accent); }
  .row:hover h3 { color: var(--accent); }
  .row h3 { transition: color var(--dur-quick) ease, transform 180ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .row:hover h3 { transform: translateX(0.6rem); }
    .row:hover .row-arrow { transform: translateX(4px); }
  }
  /* Bild schwebt beim Hover neben der Zeile ein; nur mit Maus, nie auf Touch */
  .row-shot {
    position: absolute;
    right: 6rem;
    top: 50%;
    width: 17rem;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
    opacity: 0;
    transform: translateY(-46%) scale(0.95) rotate(1.5deg);
    transform-origin: right center;
    transition: opacity 220ms ease, transform 220ms var(--ease-out);
    pointer-events: none;
    z-index: 2;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1100px) {
    .row:hover .row-shot, .row:focus-visible .row-shot { opacity: 1; transform: translateY(-50%) rotate(-1.5deg); }
  }

  .all { margin: 2.5rem 0 0; }

  /* Ueber mich */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(6rem, 16vh, 11rem);
  }
  .about-photo img { width: 100%; height: auto; border-radius: var(--radius-lg); border: 1px solid var(--border); filter: saturate(0.92); }
  .about h2 { margin-bottom: 1.5rem; }
  .about .lede { margin-bottom: 1.75rem; }
  .stack { margin-top: 2.5rem; }
  .stack-label { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.7rem; }
  .stack .tags { list-style: none; margin: 0; padding: 0; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; align-items: start; min-height: 0; padding-block: 3rem 4rem; }
    .duo { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr 1.5rem; }
    .row p { grid-column: 1; }
    .row-stack { grid-column: 1; white-space: normal; }
    .row-arrow { grid-column: 2; grid-row: 1; }
    .about { grid-template-columns: 1fr; }
    .about-photo { max-width: 14rem; }
  }
  .ki { padding-block: clamp(5rem, 12vh, 9rem); }
  .certs-sec { padding-block: 0 clamp(5rem, 12vh, 9rem); }
</style>
