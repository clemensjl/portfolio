---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import PreviewSlot from '../../../components/PreviewSlot.astro';
import { useTranslations, langStaticPaths, type Lang } from '../../../i18n';
import { hasShots } from '../../../lib/shots';

// Wichtig: klassische Funktionsform. Ein Arrow-Export (`export const getStaticPaths = () => …`)
// bringt den Astro-Compiler dazu, die restliche Frontmatter auf Modulebene zu hoisten,
// wo Astro.params undefined ist — Build bricht mit "Cannot read properties of undefined (reading 'lang')".
export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const ofLang = (e: { id: string }) => e.id.startsWith(`${lang}/`);

const projects = (await getCollection('projects', ofLang)).sort(
  // Flaggschiffe zuerst (in ihrer Startseiten-Reihenfolge), danach der Rest nach `order`
  (a, b) => (a.data.flagship ?? 99) - (b.data.flagship ?? 99) || a.data.order - b.data.order
);
const ventures = (await getCollection('ventures', ofLang)).sort((a, b) => a.data.order - b.data.order);

// Reihenfolge der Rubriken; Racep Labs kommt aus der ventures-Collection.
const order = ['agent-labs', 'claude-skills', 'racep-labs', 'client', 'apps', 'experiments'] as const;
const groups = order
  .map((cat) => ({ cat, items: cat === 'racep-labs' ? [] : projects.filter((p) => p.data.category === cat) }))
  .filter((g) => g.cat === 'racep-labs' ? ventures.length > 0 : g.items.length > 0);
---

<Base
  lang={lang}
  title={`${t('projects.title')} | Clemens Jele`}
  description={t('projects.description')}
  path="/projects/"
>
  <Header lang={lang} path="/projects/" />
  <main id="main" class="container page">
    <h1>{t('projects.title')}</h1>
    <p class="lede">{t('projects.description')}</p>

    <nav class="cats" aria-label={t('projects.title')}>
      {groups.map((g) => <a class="tag" href={`#${g.cat}`}>{t(`projects.cat.${g.cat}`)}</a>)}
    </nav>

    {groups.map((g) => (
      <section class="cat" id={g.cat} aria-labelledby={`${g.cat}-title`}>
        <h2 id={`${g.cat}-title`} data-reveal>{t(`projects.cat.${g.cat}`)}</h2>
        <p class="cat-lede" data-reveal style="--i:1">{t(`projects.cat.${g.cat}.lede`)}</p>
        <div class="grid">
          {g.cat === 'racep-labs'
            ? ventures.map((v, i) => {
                const slug = v.id.split('/')[1];
                return (
                  <a class="venture" href={`/${lang}/startup/#${slug}`} data-reveal style={`--i:${i % 3}`}>
                    {hasShots(v.data.preview) && <div class="live"><PreviewSlot lang={lang} name={v.data.preview} decorative /></div>}
                    <h3>{v.data.title}</h3>
                    <p>{v.data.summary}</p>
                    <p class="venture-role mono">{v.data.role}</p>
                  </a>
                );
              })
            : g.items.map((p, i) => <ProjectCard lang={lang} project={p} index={i} />)}
        </div>
      </section>
    ))}
  </main>
  <Footer lang={lang} path="/projects/" />
</Base>

<style>
  .page { padding-block: clamp(3rem, 8vh, 6rem) 2rem; }
  .page h1 { margin-bottom: 1.25rem; }
  .cats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .cats a { color: var(--text); }
  .cats a:hover { text-decoration: none; border-color: var(--faint); }
  .cat { margin-top: clamp(4rem, 10vh, 7rem); scroll-margin-top: 5rem; }
  .cat h2 { font-size: clamp(1.8rem, 1.3rem + 2vw, 2.8rem); margin-bottom: 0.5rem; }
  .cat-lede { color: var(--muted); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
  }
  .venture { display: block; color: var(--text); }
  .venture:hover { text-decoration: none; }
  .venture h3 { margin-bottom: 0.6rem; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem); }
  .venture .live { margin-bottom: 0.5rem; }
  .venture .live :global(.pv) { border-radius: var(--radius); box-shadow: none; }
  .venture-role { color: var(--muted); font-size: 0.85rem; margin-top: 0.5rem; }
</style>
