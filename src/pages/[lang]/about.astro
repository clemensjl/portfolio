---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, langStaticPaths, type Lang } from '../../i18n';

// Wichtig: klassische Funktionsform. Ein Arrow-Export (`export const getStaticPaths = () => …`)
// bringt den Astro-Compiler dazu, die restliche Frontmatter auf Modulebene zu hoisten,
// wo Astro.params undefined ist — Build bricht mit "Cannot read properties of undefined (reading 'lang')".
export function getStaticPaths() {
  return langStaticPaths;
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const paragraphs: Record<Lang, string[]> = {
  de: [
    'Ich bin Clemens Jele, Jahrgang 2010, Schüler an der HTL Mössingerstraße in Klagenfurt in der Abteilung Elektronik & IT — und Softwareentwickler.',
    'Angefangen hat es mit kleinen Tools für den eigenen Rechner — daraus wurden Desktop-Utilities wie KernClean, datenlastige Web-Apps wie Kern Search und Automatisierung rund um echte Workflows. Mich interessiert Software, die ein konkretes Problem löst und danach einfach läuft.',
    'Zuletzt drehte sich das meiste um KI-Werkzeuge: Agent Deck als Cockpit für mehrere Coding-Agenten, agentfenster als Kontrollraum für Klick-Agenten auf einem eigenen Windows-Desktop, KernMind als selbst gehostetes zweites Gehirn, dazu eine Sammlung von Agent Skills für Rechtstexte nach österreichischem und europäischem Recht.',
    'Neben der Schule baue ich mit zwei Freunden als Racep Labs an Märchenfuchs und Lifemate.',
    'Abseits vom Code: Skifahren, Mopedfahren, Fitness — und alles rund um KI-Automation und KI-gestütztes Programmieren.',
  ],
  en: [
    'I am Clemens Jele, born 2010, a student in the Electronics & IT department at HTL Mössingerstraße in Klagenfurt, Austria — and a software developer.',
    'It started with small tools for my own machine — which turned into desktop utilities like KernClean, data-heavy web apps like Kern Search and automation around real workflows. I care about software that solves a concrete problem and then just keeps running.',
    'Lately most of it has revolved around AI tooling: Agent Deck as a cockpit for running several coding agents, agentfenster as a control room for click agents on a desktop of their own, KernMind as a self-hosted second brain, plus a set of agent skills for legal texts under Austrian and European law.',
    'Outside of school I am building Märchenfuchs and Lifemate with two friends as Racep Labs.',
    'Away from the keyboard: skiing, riding my moped, fitness — and everything around AI automation and AI-assisted coding.',
  ],
};
---

<Base lang={lang} title={`${t('about.title')} — Clemens Jele`} description={t('about.description')} path="/about/">
  <Header lang={lang} />
  <main class="container">
    <h1>{t('about.title')}</h1>
    <div class="prose">
      {paragraphs[lang].map((p) => <p>{p}</p>)}
    </div>
  </main>
  <Footer lang={lang} path="/about/" />
</Base>

<style>
  .prose { max-width: 44rem; }
</style>
